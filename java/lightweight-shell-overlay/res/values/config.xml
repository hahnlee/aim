<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No wallpaper is drawn (ImageWallpaper was SystemUI's): the
         screen does not wait for one at boot. WallpaperManagerService and
         its API stay. -->
    <bool name="config_checkWallpaperAtBoot">false</bool>

    <!-- The services only the launcher and SystemUI use: SystemServer
         starts none of them. AppPrediction stays (the share sheet's). -->
    <string name="config_defaultSearchUiService" translatable="false"></string>
    <string name="config_defaultSmartspaceService" translatable="false"></string>
    <string name="config_defaultContextualSearchPackageName" translatable="false"></string>
    <string name="config_defaultWallpaperEffectsGenerationService" translatable="false"></string>
    <string name="config_defaultContentSuggestionsService" translatable="false"></string>
</resources>
