# The aim device: the original Android userspace as Darwin processes
# (docs/adr/0012-original-android-userspace.md). init.rc imports
# /vendor/etc/init/hw/init.${ro.hardware}.rc, and aim-guest-init boots
# with androidboot.hardware=aim. Only what this device needs is here;
# the HALs start from their own .rc files.

on early-init
    # The GLES driver the original libEGL loads:
    # /vendor/lib64/egl/libGLES_aim.so (docs/gles-driver.md).
    setprop ro.hardware.egl aim
    # ANGLE's Metal backend implements OpenGL ES 3.0 (0x30000).
    setprop ro.opengles.version 196608
    # The Vulkan driver the original libvulkan loads:
    # /vendor/lib64/hw/vulkan.aim.so (docs/vulkan-driver.md).
    setprop ro.hardware.vulkan aim
    # RenderEngine renders with GLES: the Vulkan driver's presents wait on
    # the CPU until there are sync files (docs/vulkan-driver.md).
    setprop debug.renderengine.backend skiaglthreaded
    # A Retina display at 2x.
    setprop ro.sf.lcd_density 320
    # No boot animation: bootanimation starts, sees this and exits
    # without reading bootanimation.zip (whose reads the Mac's security
    # agent flagged, #232); the window stays black until the first frame.
    setprop debug.sf.nobootanimation 1
    # The display is a window: Core Animation shows a frame, and its present
    # fence signals, about two vsyncs after SurfaceFlinger presents it
    # (docs/composer.md). SurfaceFlinger releases a client target on the
    # next frame's present fence, so it keeps three in flight, and does not
    # hold back a GPU-composited frame while the previous present fence is
    # pending; otherwise it presents every other vsync.
    setprop ro.surface_flinger.max_frame_buffer_acquired_buffers 3
    setprop debug.sf.enable_gl_backpressure 0
    # Present fences signal when the frame was shown, so SurfaceFlinger
    # keeps its vsync model with them and enables vsync only to resync.
    # The emulator's vendor properties, which this image starts from,
    # ignore them, and SurfaceFlinger then keeps vsync on for good.
    setprop debug.sf.vsync_reactor_ignore_present_fences false
    # SystemServer's switches for a device without these functions
    # (docs/system-services.md, "Shrinking SystemServer"): the Mac owns
    # the clock, so no NetworkTimeUpdateService; the image is updated by
    # `cargo aim`, never by an A/B OTA, so no OtaDexoptService.
    setprop config.disable_networktime true
    setprop config.disable_otadexopt true
    # The lightweight shell (docs/m1-shell.md): no SystemUI, so
    # guest-init starts the native status bar in its place, and the
    # window shell organizes the tasks; without WMShell no window
    # decoration draws a caption in a freeform task, so aim-windows
    # reports none and the Mac's title bar is its own.
    setprop ro.vendor.aim.lightweight_shell true
    setprop ro.vendor.aim.freeform_caption_dp 0

# Partitions are directories of the derived image and /data is a host
# directory: aim-guest-init's mount_all mounts nothing and raises the
# triggers init would.
on fs
    mount_all /vendor/etc/fstab.aim --early

on late-fs
    mount_all /vendor/etc/fstab.aim --late

# The Mac's time zone, language and appearance (docs/mac-settings.md):
# aim-guest-init sets vendor.aim.mac.* before the first action, and the
# time zone and appearance again when the Mac changes them.

# After init.rc's post-fs-data has loaded the persistent properties, and
# before zygote-start: the Mac's zone and language replace the persisted
# ones for this boot.
on post-fs-data
    setprop persist.sys.timezone ${vendor.aim.mac.time_zone}
    setprop persist.sys.locale ${vendor.aim.mac.locale}

# A zone change while Android runs goes through AlarmManager.setTimeZone,
# which broadcasts it and which the time zone detector reads back.
on property:sys.boot_completed=1 && property:vendor.aim.mac.time_zone=*
    exec_background - system system -- /system/bin/cmd alarm set-timezone ${vendor.aim.mac.time_zone}

# The keyboard layout goes to InputManager as the built-in keyboard's
# layout override (docs/input.md, "Layouts"), once the system is ready
# and on each change of the Mac's.
on property:sys.boot_completed=1 && property:vendor.aim.mac.keyboard_layout=*
    exec_background - system system -- /system_ext/bin/aim-keyboard layout ${vendor.aim.mac.keyboard_layout}
