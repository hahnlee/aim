# The aim device's fstab, read by init's mount_all and by vold. /data is
# the data image on the Mac, file-encrypted as fscrypt v2 by the syscall
# layer (ADR 0016); the partitions are directories of the derived image,
# not block devices.
#<src>               <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>
/dev/block/userdata  /data        ext4    noatime,nosuid,nodev     wait,latemount,fileencryption=aes-256-xts:aes-256-cts:v2
