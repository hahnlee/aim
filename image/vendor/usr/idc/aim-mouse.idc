# The Mac's pointer as an absolute mouse (docs/input.md): ABS_X/ABS_Y in
# the display's pixels under the Mac's cursor, BTN_TOOL_MOUSE while it is
# over a window (hover), the right, middle, back and forward buttons, and
# high-resolution scrolling on both axes. The primary button is a touch on
# aim-touchscreen. A pointer device, so its events are the mouse's and
# scroll where the pointer is.

device.internal = 1

touch.deviceType = pointer
