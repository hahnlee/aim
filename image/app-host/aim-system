#!/system/bin/sh
# The app host's system process (docs/app-host.md): what runs only in
# system_server (the original AppSearch module, the Connectivity module's
# NearbyService, the AdServices module's AdServicesManagerService, DeviceLockService,
# TelecomLoaderService's part and the components of
# `android:process="system"`), run by
# aim-services.jar's SystemProcessHost, as /system/bin/am runs its jar;
# SystemProcessHost makes system_server's class loader of
# SYSTEMSERVERCLASSPATH itself.
export CLASSPATH=/system/framework/aim-services.jar
exec app_process /system/bin dev.aim.server.SystemProcessHost "$@"
