diff --git a/ojluni/src/main/native/NativeThread.c b/ojluni/src/main/native/NativeThread.c
--- a/ojluni/src/main/native/NativeThread.c
+++ b/ojluni/src/main/native/NativeThread.c
@@ -25,6 +25,7 @@

 #include <sys/types.h>
+#include <errno.h>
 #include <string.h>
 #include "jni.h"
 #include "jni_util.h"
@@ -74,6 +75,40 @@ nullHandler(int sig)
 {
 }

+static pthread_mutex_t aim_signal_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct sigaction aim_previous_signal_action;
+static int aim_signal_installed;
+
+int aim_install_sun_nio_ch_NativeThread_signal(void)
+{
+    struct sigaction sa, osa;
+    sa.sa_handler = nullHandler;
+    sa.sa_flags = 0;
+    sigemptyset(&sa.sa_mask);
+    pthread_mutex_lock(&aim_signal_lock);
+    if (!aim_signal_installed &&
+        sigaction(INTERRUPT_SIGNAL, &sa, &osa) < 0) {
+        int result = errno;
+        pthread_mutex_unlock(&aim_signal_lock);
+        return result;
+    }
+    if (!aim_signal_installed) {
+        aim_previous_signal_action = osa;
+        aim_signal_installed = 1;
+    }
+    pthread_mutex_unlock(&aim_signal_lock);
+    return 0;
+}
+
+int aim_restore_sun_nio_ch_NativeThread_signal(void)
+{
+    int result = 0;
+    pthread_mutex_lock(&aim_signal_lock);
+    if (aim_signal_installed &&
+        sigaction(INTERRUPT_SIGNAL, &aim_previous_signal_action, NULL) < 0) {
+        result = errno;
+    } else {
+        aim_signal_installed = 0;
+    }
+    pthread_mutex_unlock(&aim_signal_lock);
+    return result;
+}
+
 static void  NativeThread_init(JNIEnv *env)
 {
@@ -83,13 +118,11 @@ static void  NativeThread_init(JNIEnv *env)
      * should somehow be unified, perhaps within the VM.
      */

-    sigset_t ss;
-    struct sigaction sa, osa;
-    sa.sa_handler = nullHandler;
-    sa.sa_flags = 0;
-    sigemptyset(&sa.sa_mask);
-    if (sigaction(INTERRUPT_SIGNAL, &sa, &osa) < 0)
+    int result = aim_install_sun_nio_ch_NativeThread_signal();
+    if (result != 0) {
+        errno = result;
         JNU_ThrowIOExceptionWithLastError(env, "sigaction");
+    }
 }
