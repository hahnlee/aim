diff --git a/libartbase/base/globals.h b/libartbase/base/globals.h
--- a/libartbase/base/globals.h
+++ b/libartbase/base/globals.h
@@ -28,6 +28,35 @@
 static constexpr size_t MB = KB * KB;
 static constexpr size_t GB = KB * KB * KB;
 
+// Managed heap references are 32 bits wide. Upstream ART stores them as the
+// absolute address of the object, so the heap, the boot image and every other
+// "low 4 GiB" mapping must lie below 4 GiB. A nonzero ART_HEAP_REFERENCE_BASE
+// (a 4 GiB-aligned address set by the build, like ART_BASE_ADDRESS) moves that
+// 4 GiB window up to the base: a reference is then the object's offset from the
+// base, and because the base is 4 GiB-aligned the offset is simply the low 32
+// bits of the address. Zero keeps upstream behaviour.
+#ifndef ART_HEAP_REFERENCE_BASE
+#define ART_HEAP_REFERENCE_BASE 0
+#endif
+static constexpr uintptr_t kArtCompressedReferenceBase = ART_HEAP_REFERENCE_BASE;
+static constexpr uint64_t kArtCompressedReferenceLimit =
+    static_cast<uint64_t>(kArtCompressedReferenceBase) + 4ULL * GB;
+static_assert(kArtCompressedReferenceBase % (4ULL * GB) == 0,
+              "the heap reference window must be 4 GiB aligned");
+
+// Image files and 32-bit metadata keep Android's logical low-4 GiB addresses
+// (for example ART_BASE_ADDRESS). These convert between such a logical address
+// and the address inside the window; other addresses pass through unchanged.
+ALWAYS_INLINE constexpr uintptr_t ArtCompressedReferenceToHostAddress(uintptr_t address) {
+  return address != 0u && address < 4ULL * GB ? kArtCompressedReferenceBase + address : address;
+}
+
+ALWAYS_INLINE constexpr uintptr_t ArtHostAddressToCompressedReferenceAddress(uintptr_t address) {
+  return address >= kArtCompressedReferenceBase && address < kArtCompressedReferenceLimit
+      ? address - kArtCompressedReferenceBase
+      : address;
+}
+
 // Runtime sizes.
 static constexpr size_t kBitsPerByte = 8;
 static constexpr size_t kBitsPerByteLog2 = 3;
