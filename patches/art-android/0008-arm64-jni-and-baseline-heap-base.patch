+void Arm64JNIMacroAssembler::DecodeHeapReference(ManagedRegister m_reg) {
+  Arm64ManagedRegister reg = m_reg.AsArm64();
+  CHECK(reg.IsWRegister());
+  ReferenceCodegenARM64<>::DecodeNonNull(asm_.GetVIXLAssembler(),
+                                         reg_x(reg.AsOverlappingXRegister()),
+                                         reg_w(reg.AsWRegister()));
+}
+
+void Arm64JNIMacroAssembler::NormalizeMethodPointer(ManagedRegister m_reg) {
+#if ART_HEAP_REFERENCE_BASE != 0
+  Arm64ManagedRegister reg = m_reg.AsArm64();
+  CHECK(reg.IsXRegister());
+  UseScratchRegisterScope temps(asm_.GetVIXLAssembler());
+  Register upper = temps.AcquireX();
+  vixl::aarch64::Label native_pointer;
+  ___ Lsr(upper, reg_x(reg.AsXRegister()), 32u);
+  ___ Cbnz(upper, &native_pointer);
+  ___ Orr(reg_x(reg.AsXRegister()), reg_x(reg.AsXRegister()), kArtCompressedReferenceBase);
+  ___ Bind(&native_pointer);
+#else
+  UNUSED(m_reg);
+#endif
 }
 
