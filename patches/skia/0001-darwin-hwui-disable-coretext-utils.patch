--- a/BUILD.gn
+++ b/BUILD.gn
@@ -1666,6 +1666,18 @@ optional("skia") {
   sources = []
   sources += skia_core_sources
   sources += skia_utils_private
+
+  # The generated utils list is intentionally platform-complete. On Android,
+  # SkFeatures makes these CoreText implementations empty. A Darwin host build
+  # instead needs to remove them when the macOS font host is disabled, otherwise
+  # whole-static HWUI linking imports CoreText despite using AOSP FreeType.
+  if (is_mac && !skia_use_fonthost_mac) {
+    sources -= [
+      get_path_info("src/utils/mac/SkCTFont.cpp", "abspath"),
+      get_path_info("src/utils/mac/SkCTFontCreateExactCopy.cpp", "abspath"),
+    ]
+  }
+
   sources += skia_utils_chromium
   sources += skia_effects_sources
   sources += skia_colorfilters_sources
