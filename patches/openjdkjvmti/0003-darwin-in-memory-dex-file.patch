--- a/ti_search.cc
+++ b/ti_search.cc
@@ -30,5 +30,6 @@
  */
 
+#include <cstdlib>
 #include <sstream>
 #include <unistd.h>
 
@@ -277,11 +278,30 @@ jvmtiError SearchUtil::AddToDexClassLoaderInMemory(jvmtiEnv* jvmti_env,
   // We have java APIs for adding files to the classpath, we might as well use them. It simplifies a
   // lot of code as well.
 
+#if defined(__APPLE__)
+  // Darwin has neither memfd_create() nor procfs. Use an app-private,
+  // mode-0600 temporary file as the backing object and unlink it as soon as
+  // AddToDexClassLoader has opened/mapped the DEX. This preserves the Android
+  // lifetime contract: no persistent pathname and no descriptor leak.
+  const char* private_root = std::getenv("AIM_ANDROID_PRIVATE_DATA_ROOT");
+  std::string temporary_path =
+      private_root != nullptr
+          ? std::string(private_root) + "/local/tmp/jvmti-dex.XXXXXX"
+          : "/tmp/jvmti-dex.XXXXXX";
+  std::vector<char> temporary_path_buffer(temporary_path.begin(), temporary_path.end());
+  temporary_path_buffer.push_back('\0');
+  art::File file(mkstemp(temporary_path_buffer.data()), /*check-usage=*/true);
+  std::string seg(temporary_path_buffer.data());
+#else
   // Create a memfd
   art::File file(art::memfd_create("JVMTI InMemory Added dex file", 0), /*check-usage*/true);
+  std::ostringstream oss;
+  oss << "/proc/self/fd/" << file.Fd();
+  std::string seg(oss.str());
+#endif
   if (file.Fd() < 0) {
     char* reason = strerror(errno);
-    JVMTI_LOG(ERROR, jvmti_env) << "Unable to create memfd due to " << reason;
+    JVMTI_LOG(ERROR, jvmti_env) << "Unable to create in-memory DEX backing due to " << reason;
     if (file.FlushClose() < 0) {
       PLOG(WARNING) << "Failed to close file!";
     }
@@ -293,10 +313,6 @@ jvmtiError SearchUtil::AddToDexClassLoaderInMemory(jvmtiEnv* jvmti_env,
     }
     return ERR(INTERNAL);
   }
-  // Get the filename in procfs.
-  std::ostringstream oss;
-  oss << "/proc/self/fd/" << file.Fd();
-  std::string seg(oss.str());
   // Use common code.
 
   jvmtiError result = AddToDexClassLoader(jvmti_env, classloader, seg.c_str());
@@ -308,5 +324,10 @@ jvmtiError SearchUtil::AddToDexClassLoaderInMemory(jvmtiEnv* jvmti_env,
   if (file.Close() != 0) {
     JVMTI_LOG(WARNING, jvmti_env) << "Failed to close memfd!";
   }
+#if defined(__APPLE__)
+  if (unlink(seg.c_str()) != 0) {
+    PLOG(WARNING) << "Failed to unlink in-memory DEX backing file";
+  }
+#endif
   return result;
 }
