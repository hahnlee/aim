diff --git a/ti_timers.cc b/ti_timers.cc
index 49340f6..8319514 100644
--- a/ti_timers.cc
+++ b/ti_timers.cc
@@ -33,11 +33,7 @@
 
 #include <limits>
 
-#ifndef __APPLE__
 #include <time.h>
-#else
-#include <sys/time.h>
-#endif
 #include <unistd.h>
 
 #include "art_jvmti.h"
@@ -74,18 +70,12 @@ jvmtiError TimerUtil::GetTime([[maybe_unused]] jvmtiEnv* env, jlong* nanos_ptr)
     return ERR(NULL_POINTER);
   }
 
-#ifndef __APPLE__
-  // Use the same implementation as System.nanoTime.
+  // Android's contract is the same monotonic nanosecond clock used by
+  // System.nanoTime(). Modern Darwin provides CLOCK_MONOTONIC as well; the
+  // old Apple gettimeofday fallback returned epoch time and broke that ABI.
   struct timespec now;
   clock_gettime(CLOCK_MONOTONIC, &now);
   *nanos_ptr = now.tv_sec * 1000000000LL + now.tv_nsec;
-#else
-  // No CLOCK_MONOTONIC support on older Mac OS.
-  struct timeval t;
-  t.tv_sec = t.tv_usec = 0;
-  gettimeofday(&t, nullptr);
-  *nanos_ptr = static_cast<jlong>(t.tv_sec)*1000000000LL + static_cast<jlong>(t.tv_usec)*1000LL;
-#endif
 
   return ERR(NONE);
 }
