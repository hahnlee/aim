 int ashmem_create_region(const char* /*ignored*/, size_t size) {
+#if defined(__APPLE__)
+    // ActivityThread points TMPDIR at the app's Android cache path, which does
+    // not name a host directory; tmpfile() follows TMPDIR and fails. Create the
+    // same unlinked regular file directly in the host temporary directory.
+    char path[] = "/tmp/android-ashmem.XXXXXX";
+    unique_fd fd(mkstemp(path));
+    if (fd == -1) {
+        return -1;
+    }
+    if (unlink(path) == -1) {
+        return -1;
+    }
+    if (TEMP_FAILURE_RETRY(ftruncate(fd, size)) == -1) {
+        return -1;
+    }
+    return fd.release();
