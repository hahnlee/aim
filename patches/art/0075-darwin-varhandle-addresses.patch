+// Metadata checks run before target.offset is computed, so its dedicated temp
+// is available for native addresses without consuming the two VIXL scratch registers.
+static MemOperand VarHandleHeapOperand(HInvoke* invoke, CodeGeneratorARM64* codegen,
+                                       Register reference, int32_t offset) {
+  Register address = XRegisterFrom(invoke->GetLocations()->GetTemp(0u));
+  ReferenceCodegenARM64<>::DecodeNonNull(codegen->GetVIXLAssembler(), address, reference.W());
+  return MemOperand(address, offset);
+}
