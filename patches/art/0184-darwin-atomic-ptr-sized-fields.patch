diff --git a/runtime/art_method.h b/runtime/art_method.h
--- a/runtime/art_method.h
+++ b/runtime/art_method.h
@@ -1192,6 +1192,13 @@
     if (pointer_size == PointerSize::k32) {
       return reinterpret_cast<T>(*reinterpret_cast<const uint32_t*>(addr));
     } else {
+#if defined(__APPLE__)
+      // Compiled quick code reads entrypoints concurrently with
+      // instrumentation/JIT publication. Use acquire semantics for the
+      // naturally aligned image pointer on Darwin.
+      auto v = __atomic_load_n(reinterpret_cast<const uint64_t*>(addr), __ATOMIC_ACQUIRE);
+#else
-      auto v = *reinterpret_cast<const uint64_t*>(addr);
+      auto v = *reinterpret_cast<const uint64_t*>(addr);
+#endif
       return reinterpret_cast<T>(dchecked_integral_cast<uintptr_t>(v));
     }
@@ -1209,6 +1209,12 @@
       uintptr_t ptr = reinterpret_cast<uintptr_t>(new_value);
       *reinterpret_cast<uint32_t*>(addr) = dchecked_integral_cast<uint32_t>(ptr);
     } else {
+#if defined(__APPLE__)
+      __atomic_store_n(reinterpret_cast<uint64_t*>(addr),
+                       reinterpret_cast<uint64_t>(new_value),
+                       __ATOMIC_RELEASE);
+#else
-      *reinterpret_cast<uint64_t*>(addr) = reinterpret_cast<uintptr_t>(new_value);
+      *reinterpret_cast<uint64_t*>(addr) = reinterpret_cast<uintptr_t>(new_value);
+#endif
     }
   }
