 }  // namespace art
+
+#if defined(__APPLE__)
+extern "C" int aim_pthread_getname_np(pthread_t thread,
+                                               char* name,
+                                               size_t size) {
+  if (name == nullptr || size == 0u) {
+    return EINVAL;
+  }
+  std::string logical_name;
+  if (!art::ReadDarwinLogicalThreadName(thread, &logical_name)) {
+    return pthread_getname_np(thread, name, size);
+  }
+  if (logical_name.size() + 1u > size) {
+    return ERANGE;
+  }
+  memcpy(name, logical_name.c_str(), logical_name.size() + 1u);
+  return 0;
+}
+
+extern "C" int aim_pthread_setname_np(pthread_t thread,
+                                               const char* name) {
+  if (name == nullptr) {
+    return EINVAL;
+  }
+  art::RecordDarwinLogicalThreadName(thread, name);
+  return pthread_equal(thread, pthread_self()) ? pthread_setname_np(name) : 0;
+}
+#endif
