 namespace art {
 
+#if defined(__APPLE__)
+namespace {
+
+struct DarwinLogicalThreadName {
+  pthread_t thread;
+  std::string name;
+};
+
+std::mutex gDarwinLogicalThreadNamesLock;
+std::vector<DarwinLogicalThreadName> gDarwinLogicalThreadNames;
+
+void RecordDarwinLogicalThreadName(pthread_t thread, const char* name) {
+  std::lock_guard<std::mutex> lock(gDarwinLogicalThreadNamesLock);
+  for (DarwinLogicalThreadName& record : gDarwinLogicalThreadNames) {
+    if (pthread_equal(record.thread, thread)) {
+      record.name = name;
+      return;
+    }
+  }
+  gDarwinLogicalThreadNames.push_back({thread, name});
+}
+
+bool ReadDarwinLogicalThreadName(pthread_t thread, std::string* name) {
+  std::lock_guard<std::mutex> lock(gDarwinLogicalThreadNamesLock);
+  for (const DarwinLogicalThreadName& record : gDarwinLogicalThreadNames) {
+    if (pthread_equal(record.thread, thread)) {
+      *name = record.name;
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+#endif
