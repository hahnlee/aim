@@ -495,1 +499,37 @@
+MemMap MemMap::MapAnonymousExact(const char* name,
+                                 uint8_t* addr,
+                                 size_t byte_count,
+                                 int prot,
+                                 std::string* error_msg) {
+#if defined(__APPLE__)
+  if (addr == nullptr || byte_count == 0 || !IsAlignedParam(addr, GetPageSize())) {
+    *error_msg = "Darwin exact anonymous mapping requires aligned address and non-zero size";
+    return Invalid();
+  }
+  size_t size = RoundUp(byte_count, GetPageSize());
+  mach_vm_address_t fixed = reinterpret_cast<mach_vm_address_t>(addr);
+  const kern_return_t status = mach_vm_allocate(mach_task_self(), &fixed, size, VM_FLAGS_FIXED);
+  if (status != KERN_SUCCESS) {
+    *error_msg = StringPrintf("Darwin exact allocation at %p failed: %d (%s)",
+                              addr, status, mach_error_string(status));
+    return Invalid();
+  }
+  if (mprotect(reinterpret_cast<void*>(fixed), size, prot) != 0) {
+    mach_vm_deallocate(mach_task_self(), fixed, size);
+    *error_msg = StringPrintf("Darwin exact allocation protection at %p failed", addr);
+    return Invalid();
+  }
+  return MemMap(name,
+                reinterpret_cast<uint8_t*>(fixed),
+                byte_count,
+                reinterpret_cast<void*>(fixed),
+                size,
+                prot,
+                /* reuse= */ false);
+#else
+  UNUSED(name, addr, byte_count, prot, error_msg);
+  return Invalid();
+#endif
+}
