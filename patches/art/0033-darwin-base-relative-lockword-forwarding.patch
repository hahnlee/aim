diff --git a/runtime/lock_word.h b/runtime/lock_word.h
--- a/runtime/lock_word.h
+++ b/runtime/lock_word.h
@@ -25,3 +25,4 @@
 #include "base/bit_utils.h"
+#include "base/globals.h"
 #include "base/macros.h"
 #include "read_barrier.h"
@@ -152,4 +152,16 @@ class LockWord {
   static LockWord FromForwardingAddress(size_t target) {
     DCHECK_ALIGNED(target, (1 << kStateSize));
-    return LockWord((target >> kForwardingAddressShift) | kStateForwardingAddressShifted);
+#if defined(__APPLE__) && defined(__LP64__)
+    // Darwin reserves the low 4 GiB for __PAGEZERO.  The forwarding payload
+    // remains a 32-bit word, so store the managed-window offset rather than
+    // truncating the high address before the object is moved.
+    DCHECK_GE(target, kArtCompressedReferenceBase);
+    DCHECK_LT(target, kArtCompressedReferenceLimit);
+    const uintptr_t offset = target - kArtCompressedReferenceBase;
+    DCHECK_ALIGNED(offset, (1 << kForwardingAddressShift));
+    return LockWord((static_cast<uint32_t>(offset >> kForwardingAddressShift)) |
+                    kStateForwardingAddressShifted);
+#else
+    return LockWord((target >> kForwardingAddressShift) | kStateForwardingAddressShifted);
+#endif
   }
diff --git a/runtime/lock_word-inl.h b/runtime/lock_word-inl.h
--- a/runtime/lock_word-inl.h
+++ b/runtime/lock_word-inl.h
@@ -44,4 +44,12 @@ inline Monitor* LockWord::FatLockMonitor() const {
 inline size_t LockWord::ForwardingAddress() const {
   DCHECK_EQ(GetState(), kForwardingAddress);
-  return value_ << kForwardingAddressShift;
+  // Shift the uint32_t payload first so state bits are discarded before the
+  // base is restored.  Widening value_ before the shift would retain those
+  // bits on the Darwin compressed-reference window.
+  const uintptr_t offset = static_cast<uintptr_t>(value_ << kForwardingAddressShift);
+#if defined(__APPLE__) && defined(__LP64__)
+  return kArtCompressedReferenceBase + offset;
+#else
+  return offset;
+#endif
 }
