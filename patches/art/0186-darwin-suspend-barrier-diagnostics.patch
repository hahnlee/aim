diff --git a/runtime/thread_list.cc b/runtime/thread_list.cc
--- a/runtime/thread_list.cc
+++ b/runtime/thread_list.cc
@@ -770,9 +770,20 @@ static bool WaitOnceForSuspendBarrier(AtomicInteger* barrier,
   DCHECK_GE(kInnerIters, 1'000u);
+  const bool debug_suspend = std::getenv("AIM_DEBUG_SUSPEND") != nullptr;
+  if (debug_suspend) {
+    std::fprintf(stderr, "darwin-suspend: wait begin barrier=%d timeout_ns=%llu iters=%u\n",
+                 barrier->load(std::memory_order_relaxed),
+                 static_cast<unsigned long long>(timeout_ns), kInnerIters);
+  }
   for (int i = 0; i < kInnerIters; ++i) {
     sched_yield();
     if (barrier->load(std::memory_order_acquire) == 0) {
+      if (debug_suspend) std::fprintf(stderr, "darwin-suspend: wait complete iter=%d\n", i);
       return false;
     }
   }
+  if (debug_suspend) {
+    std::fprintf(stderr, "darwin-suspend: wait timeout barrier=%d\n",
+                 barrier->load(std::memory_order_relaxed));
+  }
   return true;
 }
