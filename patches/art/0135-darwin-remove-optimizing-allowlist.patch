diff --git a/compiler/optimizing/optimizing_compiler.cc b/compiler/optimizing/optimizing_compiler.cc
--- a/compiler/optimizing/optimizing_compiler.cc
+++ b/compiler/optimizing/optimizing_compiler.cc
@@ -992,48 +992,0 @@
-#if defined(__APPLE__)
-  // Inspect sharpened calls after graph construction and before register
-  // allocation so unsupported invoke forms cannot reach an ABI-mismatched
-  // code generator. Virtual/interface receiver dereferences are handled by
-  // the Darwin ARM64 compressed-reference dispatch boundary.
-  for (HBasicBlock* block : graph->GetBlocks()) {
-    if (block == nullptr) continue;
-    for (HInstructionIterator it(block->GetInstructions()); !it.Done(); it.Advance()) {
-      HInstruction* instruction = it.Current();
-      if (instruction->IsLoadString()) {
-        auto* load = instruction->AsLoadString();
-        if (load->GetLoadKind() != HLoadString::LoadKind::kJitTableAddress &&
-            load->GetLoadKind() != HLoadString::LoadKind::kJitBootImageAddress && load->GetLoadKind() != HLoadString::LoadKind::kRuntimeCall) {
-          VLOG(jit) << "Darwin graph reject " << instruction->DebugName() << " in " << graph->PrettyMethod(); return nullptr;
-        }
-      }
-      if (instruction->IsLoadClass()) {
-        auto* load = instruction->AsLoadClass();
-        const auto kind = load->GetLoadKind();
-        if (load->NeedsAccessCheck() || load->MustGenerateClinitCheck() ||
-            (kind != HLoadClass::LoadKind::kJitTableAddress &&
-             kind != HLoadClass::LoadKind::kJitBootImageAddress &&
-             kind != HLoadClass::LoadKind::kReferrersClass)) {
-          VLOG(jit) << "Darwin graph reject " << instruction->DebugName() << " in " << graph->PrettyMethod(); return nullptr;
-        }
-      }
-      if (!instruction->IsInvoke()) continue;
-      if (instruction->IsInvokeUnresolved() || instruction->IsInvokePolymorphic() ||
-          instruction->IsInvokeCustom()) continue;
-      if (instruction->IsInvokeVirtual() || instruction->IsInvokeInterface()) {
-        auto* invoke = instruction->AsInvoke();
-        auto* resolved = invoke->GetResolvedMethod();
-        if (invoke->IsIntrinsic()) continue;
-        if (resolved == nullptr || resolved->IsStatic()) return nullptr;
-        continue;
-      }
-
-      if (!instruction->IsInvokeStaticOrDirect()) return nullptr;
-      HInvokeStaticOrDirect* invoke = instruction->AsInvokeStaticOrDirect();
-      ArtMethod* resolved = invoke->GetResolvedMethod();
-      if (invoke->IsIntrinsic()) continue;
-      if (resolved == nullptr || invoke->IsStatic() != resolved->IsStatic() ||
-          invoke->GetMethodLoadKind() != MethodLoadKind::kJitDirectAddress ||
-          invoke->GetCodePtrLocation() != CodePtrLocation::kCallArtMethod ||
-          invoke->IsStaticWithExplicitClinitCheck() ||
-          invoke->IsStaticWithImplicitClinitCheck()) {
-        VLOG(jit) << "Darwin graph reject invoke " << (resolved ? resolved->PrettyMethod() : "unresolved") << " intrinsic=" << invoke->IsIntrinsic() << " load=" << static_cast<int>(invoke->GetMethodLoadKind()) << " code=" << static_cast<int>(invoke->GetCodePtrLocation()) << " in " << graph->PrettyMethod(); return nullptr;
-      }
-    }
-  }
-#endif
