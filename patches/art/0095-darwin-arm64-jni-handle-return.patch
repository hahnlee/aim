 ManagedRegister Arm64JniCallingConvention::ReturnRegister() const {
+#if defined(__APPLE__)
+  // A JNI reference is a native jobject handle until the JNI bridge decodes
+  // it. Android can represent these handles in 32 bits; Darwin stack/local
+  // reference handles are ordinary 64-bit host addresses.
+  if (GetShorty()[0] == 'L') {
+    return Arm64ManagedRegister::FromXRegister(X0);
+  }
+#endif
   return ReturnRegisterForShorty(GetShorty());
 }
 
