diff --git a/runtime/thread.cc b/runtime/thread.cc
--- a/runtime/thread.cc
+++ b/runtime/thread.cc
@@ -84,6 +84,7 @@
 #include "mirror/class_loader.h"
 #include "mirror/object_array-alloc-inl.h"
 #include "mirror/object_array-inl.h"
+#include "mirror/object_reference.h"
 #include "mirror/stack_frame_info.h"
 #include "mirror/stack_trace_element.h"
 #include "monitor.h"
@@ -4355,7 +4356,7 @@
       uint32_t register_mask = code_info.GetRegisterMaskOf(map);
       for (uint32_t i = 0; i < BitSizeOf<uint32_t>(); ++i) {
         if (register_mask & (1 << i)) {
-          mirror::Object** ref_addr = reinterpret_cast<mirror::Object**>(GetGPRAddress(i));
+          uintptr_t* gpr_addr = GetGPRAddress(i);
-          if (kIsDebugBuild && ref_addr == nullptr) {
+          if (kIsDebugBuild && gpr_addr == nullptr) {
             std::string thread_name;
             GetThread()->GetThreadName(thread_name);
@@ -4364,9 +4365,19 @@
             DescribeStack(GetThread());
             LOG(FATAL) << "Found an unsaved callee-save register " << i << " (null GPRAddress) "
                        << "set in register_mask=" << register_mask << " at " << DescribeLocation();
           }
-          if (*ref_addr != nullptr) {
-            vreg_info.VisitRegister(ref_addr, i, this);
+          // Optimizing quick code stores references compressed in 32 bits, even though
+          // Context exposes each native register slot as a uintptr_t. Decode before
+          // handing the raw root to GC, then encode the updated root back into the slot.
+          uint32_t compressed_ref = static_cast<uint32_t>(*gpr_addr);
+          if (compressed_ref != 0u) {
+            mirror::Object* ref =
+                mirror::CompressedReference<mirror::Object>::FromVRegValue(compressed_ref)
+                    .AsMirrorPtr();
+            mirror::Object* new_ref = ref;
+            vreg_info.VisitRegister(&new_ref, i, this);
+            *gpr_addr = static_cast<uintptr_t>(
+                mirror::CompressedReference<mirror::Object>::FromMirrorPtr(new_ref).AsVRegValue());
           }
         }
       }
