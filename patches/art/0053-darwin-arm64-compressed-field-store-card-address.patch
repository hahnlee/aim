+  }
+#endif
@@ -1658,2 +1658,11 @@
-  __ Lsr(temp, object, gc::accounting::CardTable::kCardShift);
-  // assert (!clean || !self->is_gc_marking)
+#if defined(__APPLE__)
+  if (ReferenceCodegenARM64<>::kNeedsHeapBase) {
+    ReferenceCodegenARM64<>::DecodeNonNull(
+        GetVIXLAssembler(), temp.X(), object);
+    __ Lsr(temp.X(), temp.X(), gc::accounting::CardTable::kCardShift);
+  } else {
+    __ Lsr(temp, object, gc::accounting::CardTable::kCardShift);
