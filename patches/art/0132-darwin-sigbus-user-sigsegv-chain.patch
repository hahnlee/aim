diff --git a/runtime/fault_handler.cc b/runtime/fault_handler.cc
--- a/runtime/fault_handler.cc
+++ b/runtime/fault_handler.cc
@@ -35,6 +35,10 @@
 #include "verify_object-inl.h"
 
 namespace art HIDDEN {
+#if defined(__APPLE__)
+extern "C" bool aim_sigchain_dispatch_user(int, siginfo_t*, void*);
+#endif
+
 // Static fault manger object accessed by signal handler.
 FaultManager fault_manager;
 
@@ -255,9 +259,14 @@ bool FaultManager::HandleSigbusFault(int sig, siginfo_t* info, [[maybe_unused]]
 #if defined(__APPLE__)
   {
     siginfo_t normalized = *info;
     normalized.si_signo = SIGSEGV;
     normalized.si_code = SEGV_ACCERR;
-    if (HandleFaultByOtherHandlers(SIGSEGV, &normalized, context)) return true;
+    if (HandleSigsegvFault(SIGSEGV, &normalized, context)) return true;
+    // A native Android library can own the next SIGSEGV action. Darwin's
+    // original signal was SIGBUS, so explicitly continue the normalized
+    // SIGSEGV chain instead of falling through to the unrelated SIGBUS user
+    // action.
+    if (aim_sigchain_dispatch_user(SIGSEGV, &normalized, context)) return true;
   }
 #endif
 
