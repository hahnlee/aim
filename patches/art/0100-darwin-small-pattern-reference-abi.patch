 }
 
+static mirror::Object* DecodeQuickReference(mirror::Object* reference) {
+#if defined(__APPLE__)
+  return mirror::PtrCompression<false, mirror::Object>::Decompress(
+      static_cast<uint32_t>(reinterpret_cast<uintptr_t>(reference)));
+#else
+  return reference;
+#endif
+}
+
+static mirror::Object* EncodeQuickReference(ObjPtr<mirror::Object> object)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+#if defined(__APPLE__)
+  return reinterpret_cast<mirror::Object*>(static_cast<uintptr_t>(
+      mirror::PtrCompression<false, mirror::Object>::Compress(object)));
+#else
+  return object.Ptr();
+#endif
+}
+
 template <int offset, typename T>
 static std::conditional_t<(sizeof(T) < sizeof(int32_t)), int32_t, T> ReturnFieldAt(
     [[maybe_unused]] ArtMethod* method, mirror::Object* obj) REQUIRES_SHARED(Locks::mutator_lock_) {
+  obj = DecodeQuickReference(obj);
   return obj->GetFieldPrimitive<T, /* kIsVolatile= */ false>(
       MemberOffset(offset + sizeof(mirror::Object)));
 }
@@ -41,7 +61,9 @@ static std::conditional_t<(sizeof(T) < sizeof(int32_t)), int32_t, T> ReturnField
 template <int offset, typename unused>
 static mirror::Object* ReturnFieldObjectAt([[maybe_unused]] ArtMethod* method, mirror::Object* obj)
     REQUIRES_SHARED(Locks::mutator_lock_) {
-  return obj->GetFieldObject<mirror::Object>(MemberOffset(offset + sizeof(mirror::Object)));
+  obj = DecodeQuickReference(obj);
+  return EncodeQuickReference(
+      obj->GetFieldObject<mirror::Object>(MemberOffset(offset + sizeof(mirror::Object))));
 }
 
 template <int offset, typename T>
@@ -58,8 +80,8 @@ template <int offset, typename unused>
