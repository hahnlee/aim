diff --git a/runtime/entrypoints/quick/quick_trampoline_entrypoints.cc b/runtime/entrypoints/quick/quick_trampoline_entrypoints.cc
--- a/runtime/entrypoints/quick/quick_trampoline_entrypoints.cc
+++ b/runtime/entrypoints/quick/quick_trampoline_entrypoints.cc
@@ -2174,1 +2174,12 @@
-  return GenericJniMethodEnd(self, cookie, result, result_f, called);
+  uint64_t quick_result = GenericJniMethodEnd(self, cookie, result, result_f, called);
+#if defined(__APPLE__)
+  // GenericJniMethodEnd restores the runnable state and releases JNI state
+  // before this shorty read. Its reference result is native at this boundary;
+  // convert it only after cleanup so the managed quick caller receives offset32.
+  const char return_shorty = called->GetShortyView()[0];
+  if (return_shorty == 'L') {
+    quick_result = mirror::PtrCompression<false, mirror::Object>::Compress(
+        reinterpret_cast<mirror::Object*>(quick_result));
+  }
+#endif
+  return quick_result;
