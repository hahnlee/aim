diff --git a/compiler/optimizing/intrinsics_arm64.cc b/compiler/optimizing/intrinsics_arm64.cc
--- a/compiler/optimizing/intrinsics_arm64.cc
+++ b/compiler/optimizing/intrinsics_arm64.cc
@@ -3744,6 +3744,12 @@ void IntrinsicCodeGeneratorARM64::HandleValueOf(HInvoke* invoke,
     __ B(&allocate, hs);
     // If the value is within the bounds, load the object directly from the array.
     codegen_->LoadBootImageAddress(temp, info.array_data_boot_image_reference);
+    if (ReferenceCodegenARM64<>::kNeedsHeapBase) {
+      // The embedded boot-image reference denotes the array data start, not
+      // a host pointer. Preserve the AOSP cache fast path while restoring its
+      // native64 address before the indexed element load.
+      ReferenceCodegenARM64<>::DecodeNonNull(masm, temp.X(), temp.W());
+    }
     MemOperand source = HeapOperand(
         temp, out.X(), LSL, DataType::SizeShift(DataType::Type::kReference));
     codegen_->Load(DataType::Type::kReference, out, source);
