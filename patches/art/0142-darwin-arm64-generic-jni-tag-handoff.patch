diff --git a/runtime/arch/arm64/quick_entrypoints_arm64.S b/runtime/arch/arm64/quick_entrypoints_arm64.S
--- a/runtime/arch/arm64/quick_entrypoints_arm64.S
+++ b/runtime/arch/arm64/quick_entrypoints_arm64.S
@@ -1811,6 +1811,14 @@ ENTRY art_quick_generic_jni_trampoline
     // Apply the new SP for out args, releasing unneeded reserved area.
     mov sp, xIP1
 
+#if defined(__APPLE__)
+    // JNI transitions may publish the same quick frame without its GenericJNI tag.
+    // Re-establish the tagged managed-SP contract at the final handoff to native code.
+    // StackVisitor needs this tag to select the 224-byte GenericJNI frame layout.
+    orr xIP1, x28, #1
+    str xIP1, [xSELF, #THREAD_TOP_QUICK_FRAME_OFFSET]
+#endif
+
     blr xIP0        // native call.
 
     // result sign extension is handled in C code
