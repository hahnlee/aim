diff --git a/runtime/base/mutex.cc b/runtime/base/mutex.cc
--- a/runtime/base/mutex.cc
+++ b/runtime/base/mutex.cc
@@ -515,12 +515,34 @@ void Mutex::ExclusiveLock(Thread* self) {
     } while (!done);
     // Confirm that lock is now held.
     DCHECK_NE(state_and_contenders_.load(std::memory_order_relaxed) & kHeldMask, 0);
+#else
+#if defined(__APPLE__)
+    const bool darwin_monitor = level_ == kMonitorLock;
+    if (darwin_monitor) {
+      const pid_t owner_tid = SafeGetTid(self);
+      while (!exclusive_owner_.CompareAndSetWeakAcquire(0, owner_tid)) {
+        sched_yield();
+      }
+    } else {
+      CHECK_MUTEX_CALL(pthread_mutex_lock, (&mutex_));
+    }
 #else
     CHECK_MUTEX_CALL(pthread_mutex_lock, (&mutex_));
 #endif
+#endif
+#if defined(__APPLE__) && !ART_USE_FUTEXES
+    if (darwin_monitor) {
+      DCHECK_EQ(GetExclusiveOwnerTid(), SafeGetTid(self));
+    } else {
+      DCHECK_EQ(GetExclusiveOwnerTid(), 0) << " my tid = " << SafeGetTid(self)
+                                           << " recursive_ = " << recursive_;
+      exclusive_owner_.store(SafeGetTid(self), std::memory_order_relaxed);
+    }
+#else
     DCHECK_EQ(GetExclusiveOwnerTid(), 0) << " my tid = " << SafeGetTid(self)
                                          << " recursive_ = " << recursive_;
     exclusive_owner_.store(SafeGetTid(self), std::memory_order_relaxed);
+#endif
     RegisterAsLocked(self);
   }
   recursion_count_++;
@@ -608,6 +630,24 @@ bool Mutex::ExclusiveTryLock(Thread* self) {
       }
     } while (!done);
     DCHECK_NE(state_and_contenders_.load(std::memory_order_relaxed) & kHeldMask, 0);
+#else
+#if defined(__APPLE__)
+    const bool darwin_monitor = level_ == kMonitorLock;
+    if (darwin_monitor) {
+      if (!exclusive_owner_.CompareAndSetStrongSequentiallyConsistent(
+              0, SafeGetTid(self))) {
+        return false;
+      }
+    } else {
+      int result = pthread_mutex_trylock(&mutex_);
+      if (result == EBUSY) {
+        return false;
+      }
+      if (result != 0) {
+        errno = result;
+        PLOG(FATAL) << "pthread_mutex_trylock failed for " << name_;
+      }
+    }
 #else
     int result = pthread_mutex_trylock(&mutex_);
     if (result == EBUSY) {
@@ -618,8 +658,18 @@ bool Mutex::ExclusiveTryLock(Thread* self) {
       PLOG(FATAL) << "pthread_mutex_trylock failed for " << name_;
     }
 #endif
+#endif
+#if defined(__APPLE__) && !ART_USE_FUTEXES
+    if (darwin_monitor) {
+      DCHECK_EQ(GetExclusiveOwnerTid(), SafeGetTid(self));
+    } else {
+      DCHECK_EQ(GetExclusiveOwnerTid(), 0);
+      exclusive_owner_.store(SafeGetTid(self), std::memory_order_relaxed);
+    }
+#else
     DCHECK_EQ(GetExclusiveOwnerTid(), 0);
     exclusive_owner_.store(SafeGetTid(self), std::memory_order_relaxed);
+#endif
     RegisterAsLocked(self, kCheck);
   }
   recursion_count_++;
@@ -660,14 +710,15 @@ void Mutex::ExclusiveLockUncontendedFor(Thread* new_owner) {
 #if ART_USE_FUTEXES
   state_and_contenders_.store(kHeldMask, std::memory_order_relaxed);
 #else
-  // A pthread mutex cannot be acquired on behalf of another thread. This is
-  // sufficient for the single-threaded Darwin interpreter bootstrap, where a
-  // thin lock can only be inflated by its current owner.
-  CHECK_EQ(new_owner, Thread::Current());
-  CHECK_MUTEX_CALL(pthread_mutex_lock, (&mutex_));
+  // Darwin uses the logical owner word as a monitor semaphore. Unlike a
+  // pthread mutex, it can be installed on behalf of a suspended ART thread.
+  CHECK(exclusive_owner_.CompareAndSetStrongSequentiallyConsistent(
+      0, SafeGetTid(new_owner)));
 #endif
   recursion_count_ = 1;
+#if ART_USE_FUTEXES
   exclusive_owner_.store(SafeGetTid(new_owner), std::memory_order_relaxed);
+#endif
   // Don't call RegisterAsLocked(). It wouldn't register anything anyway.  And
   // this happens as we're inflating a monitor, which doesn't logically affect
   // held "locks"; it effectively just converts a thin lock to a mutex.  By doing
@@ -679,11 +730,11 @@ void Mutex::ExclusiveUnlockUncontended() {
   DCHECK_EQ(level_, kMonitorLock);
 #if ART_USE_FUTEXES
   state_and_contenders_.store(0, std::memory_order_relaxed);
-#endif
   recursion_count_ = 0;
   exclusive_owner_.store(0 /* pid */, std::memory_order_relaxed);
-#if !ART_USE_FUTEXES
-  CHECK_MUTEX_CALL(pthread_mutex_unlock, (&mutex_));
+#else
+  recursion_count_ = 0;
+  exclusive_owner_.store(0 /* pid */, std::memory_order_release);
 #endif
   // Skip RegisterAsUnlocked(), which wouldn't do anything anyway.
 }
@@ -745,9 +796,19 @@ void Mutex::ExclusiveUnlock(Thread* self) {
         }
       }
     } while (!done);
+#else
+#if defined(__APPLE__)
+    if (level_ == kMonitorLock) {
+      CHECK(exclusive_owner_.CompareAndSetStrongRelease(
+          SafeGetTid(self), 0 /* pid */));
+    } else {
+      exclusive_owner_.store(0 /* pid */, std::memory_order_relaxed);
+      CHECK_MUTEX_CALL(pthread_mutex_unlock, (&mutex_));
+    }
 #else
     exclusive_owner_.store(0 /* pid */, std::memory_order_relaxed);
     CHECK_MUTEX_CALL(pthread_mutex_unlock, (&mutex_));
+#endif
 #endif
   }
