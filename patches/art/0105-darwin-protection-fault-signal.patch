diff --git a/runtime/fault_handler.cc b/runtime/fault_handler.cc
index 6c4dc1c..15caef2 100644
--- a/runtime/fault_handler.cc
+++ b/runtime/fault_handler.cc
@@ -121,6 +121,12 @@ void FaultManager::Init(bool use_sig_chain) {
 
     AddSpecialSignalHandlerFn(SIGSEGV, &sa);
-    if (gUseUserfaultfd) {
+    if (gUseUserfaultfd ||
+#if defined(__APPLE__)
+        true
+#else
+        false
+#endif
+    ) {
       sa.sc_sigaction = art_sigbus_handler;
       AddSpecialSignalHandlerFn(SIGBUS, &sa);
     }
@@ -168,6 +174,12 @@ void FaultManager::Release() {
   if (initialized_) {
     RemoveSpecialSignalHandlerFn(SIGSEGV, art_sigsegv_handler);
-    if (gUseUserfaultfd) {
+    if (gUseUserfaultfd ||
+#if defined(__APPLE__)
+        true
+#else
+        false
+#endif
+    ) {
       RemoveSpecialSignalHandlerFn(SIGBUS, art_sigbus_handler);
     }
     initialized_ = false;
@@ -235,6 +247,20 @@ bool FaultManager::HandleSigbusFault(int sig, siginfo_t* info, [[maybe_unused]]
     return true;
   }
 
+  // Darwin reports ordinary virtual-memory protection failures as SIGBUS.
+  // Android/Linux reports the same access as SIGSEGV/SEGV_ACCERR, which is
+  // the signal contract observed by ART's non-generated-code fault handlers.
+  // Keep the host distinction at this boundary instead of teaching every
+  // Android handler about Darwin signal semantics.
+#if defined(__APPLE__)
+  {
+    siginfo_t normalized = *info;
+    normalized.si_signo = SIGSEGV;
+    normalized.si_code = SEGV_ACCERR;
+    if (HandleFaultByOtherHandlers(SIGSEGV, &normalized, context)) return true;
+  }
+#endif
+
   // Set a breakpoint in this function to catch unhandled signals.
   art_sigbus_fault();
   return false;
