diff --git a/runtime/class_linker.cc b/runtime/class_linker.cc
--- a/runtime/class_linker.cc
+++ b/runtime/class_linker.cc
@@ -66,3 +66,6 @@
 #include "base/value_object.h"
+#if defined(__APPLE__)
+#include "darwin_jit_memory.h"
+#endif
 #include "cha.h"
 #include "class_linker-inl.h"
@@ -4380,5 +4380,17 @@ void ClassLinker::LoadClassHelper::FillMethods(ObjPtr<mirror::Class> klass,
       if (UNLIKELY(use_stubs)) {
         bool is_native = ArtMethod::IsNative(access_flags);
         entrypoint = is_native ? GetQuickGenericJniStub() : GetQuickToInterpreterBridge();
       }
+#if defined(__APPLE__)
+      // Use the original oat entrypoint. Instrumentation may have replaced
+      // `entrypoint` with a bridge by this point, which is not the app code
+      // range that can fault and needs a registry entry.
+      if (src.entrypoint != nullptr &&
+          !OatQuickMethodHeader::IsStub(reinterpret_cast<const uint8_t*>(src.entrypoint)).value_or(true) &&
+          !OatQuickMethodHeader::IsNterpPc(reinterpret_cast<uintptr_t>(src.entrypoint))) {
+        OatQuickMethodHeader* header = OatQuickMethodHeader::FromEntryPoint(src.entrypoint);
+        AimRegisterJitMethod(reinterpret_cast<uintptr_t>(header->GetCode()),
+                                   header->GetCodeSize(), reinterpret_cast<uintptr_t>(dst));
+      }
+#endif
      instr->InitializeMethodsCode(dst, entrypoint, kPointerSize);
