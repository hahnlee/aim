diff --git a/runtime/interpreter/shadow_frame.h b/runtime/interpreter/shadow_frame.h
--- a/runtime/interpreter/shadow_frame.h
+++ b/runtime/interpreter/shadow_frame.h
@@ -95,9 +95,18 @@
 
   // Create a shadow frame in a fresh alloca. This needs to be in the context of the caller.
   // Inlining doesn't work, the compiler will still undo the alloca. So this needs to be a macro.
+// The constructor initializes every field and clears all vregs/GC references.
+// Avoid Clang's additional whole-alloca auto-init without disabling automatic
+// initialization elsewhere. Unlike a VLA, this storage lives until function exit.
+#if defined(__APPLE__) && defined(__clang__) && \
+    __has_builtin(__builtin_alloca_uninitialized)
+#define ART_SHADOW_FRAME_ALLOCA(size) __builtin_alloca_uninitialized(size)
+#else
+#define ART_SHADOW_FRAME_ALLOCA(size) alloca(size)
+#endif
 #define CREATE_SHADOW_FRAME(num_vregs, method, dex_pc) ({                                    \
     size_t frame_size = ShadowFrame::ComputeSize(num_vregs);                                 \
-    void* alloca_mem = alloca(frame_size);                                                   \
+    void* alloca_mem = ART_SHADOW_FRAME_ALLOCA(frame_size);                                  \
     ShadowFrameAllocaUniquePtr(                                                              \
         ShadowFrame::CreateShadowFrameImpl((num_vregs), (method), (dex_pc), (alloca_mem)));  \
     })
