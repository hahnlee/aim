diff --git a/compiler/optimizing/inliner.cc b/compiler/optimizing/inliner.cc
--- a/compiler/optimizing/inliner.cc
+++ b/compiler/optimizing/inliner.cc
@@ -17,3 +17,6 @@
 #include "inliner.h"
+#if defined(__APPLE__)
+#include "darwin_jit_eligibility.h"
+#endif
 
 #include "art_method-inl.h"
@@ -1600,2 +1603,11 @@
   DCHECK_IMPLIES(method->IsStatic(), !receiver_type.IsValid());
+#if defined(__APPLE__)
+  // Until backend coverage is complete, an inlined body must obey the same
+  // capability boundary as a separately compiled method. Keep AOSP's inliner
+  // and baseline profiling enabled; do not globally disable optimization.
+  {
+    ScopedObjectAccess soa(Thread::Current());
+    if (!jit::DarwinJitCanCompile(method, CompilationKind::kOptimized)) return false;
+  }
+#endif
   DCHECK_IMPLIES(!method->IsStatic(), receiver_type.IsValid());
diff --git a/compiler/optimizing/code_generator_arm64.cc b/compiler/optimizing/code_generator_arm64.cc
--- a/compiler/optimizing/code_generator_arm64.cc
+++ b/compiler/optimizing/code_generator_arm64.cc
@@ -5958,3 +5958,4 @@
 void InstructionCodeGeneratorARM64::VisitClearException([[maybe_unused]] HClearException* clear) {
-  __ Str(wzr, GetExceptionTlsAddress());
+  // Thread::exception is a native pointer, not a compressed heap reference.
+  __ Str(xzr, GetExceptionTlsAddress());
 }
@@ -7361,16 +7362,17 @@
 void InstructionCodeGeneratorARM64::VisitClassTableGet(HClassTableGet* instruction) {
   LocationSummary* locations = instruction->GetLocations();
+  Register out = XRegisterFrom(locations->Out());
+  ReferenceCodegenARM64<>::DecodeNonNull(
+      GetVIXLAssembler(), out, WRegisterFrom(locations->InAt(0)));
   if (instruction->GetTableKind() == HClassTableGet::TableKind::kVTable) {
     uint32_t method_offset = mirror::Class::EmbeddedVTableEntryOffset(
         instruction->GetIndex(), kArm64PointerSize).SizeValue();
-    __ Ldr(XRegisterFrom(locations->Out()),
-           MemOperand(XRegisterFrom(locations->InAt(0)), method_offset));
+    __ Ldr(out, MemOperand(out, method_offset));
   } else {
     uint32_t method_offset = static_cast<uint32_t>(ImTable::OffsetOfElement(
         instruction->GetIndex(), kArm64PointerSize));
-    __ Ldr(XRegisterFrom(locations->Out()), MemOperand(XRegisterFrom(locations->InAt(0)),
+    __ Ldr(out, MemOperand(out,
         mirror::Class::ImtPtrOffset(kArm64PointerSize).Uint32Value()));
-    __ Ldr(XRegisterFrom(locations->Out()),
-           MemOperand(XRegisterFrom(locations->Out()), method_offset));
+    __ Ldr(out, MemOperand(out, method_offset));
   }
 }
