diff --git a/runtime/thread.cc b/runtime/thread.cc
--- a/runtime/thread.cc
+++ b/runtime/thread.cc
@@ -2457,2 +2457,12 @@ void Thread::ThreadExitCallback(void* arg) {
     CHECK(is_started_);
+#if defined(__APPLE__)
+    // Darwin native workers may be attached by a translated pthread entry
+    // without Android's bionic pthread teardown wrapper. Detach through ART
+    // before the second TLS callback turns this diagnostic into a fatal abort.
+    Runtime* runtime = Runtime::Current();
+    if (runtime != nullptr) {
+      runtime->DetachCurrentThread(/* should_run_callbacks= */ false);
+    }
+    return;
+#endif
 #ifdef __BIONIC__
