+    ___ Strh(scratch.W(), MEM_OP(reg_x(SP), dest.Int32Value()));
+  } else {
+    DCHECK(size == 4u || size == 8u) << size;
+    ___ Ldr(scratch, MEM_OP(reg_x(SP), src.Int32Value()));
+    ___ Str(scratch, MEM_OP(reg_x(SP), dest.Int32Value()));
+  }
 }
