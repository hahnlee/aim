diff --git a/compiler/jni/quick/arm64/calling_convention_arm64.cc b/compiler/jni/quick/arm64/calling_convention_arm64.cc
--- a/compiler/jni/quick/arm64/calling_convention_arm64.cc
+++ b/compiler/jni/quick/arm64/calling_convention_arm64.cc
@@ -268,6 +268,75 @@ Arm64JniCallingConvention::Arm64JniCallingConvention(bool is_static,
                            shorty,
                            kArm64PointerSize) {
 }
+
+#if defined(__APPLE__)
+size_t Arm64JniCallingConvention::DarwinCurrentParamSize() const {
+  const size_t extra = NumberOfExtraArgumentsForJni();
+  if (itr_args_ < extra) return static_cast<size_t>(kArm64PointerSize);
+  const size_t arg = itr_args_ - extra;
+  if (!IsStatic() && arg == 0u) return static_cast<size_t>(kArm64PointerSize);
+  const size_t shorty_index = IsStatic() ? arg + 1u : arg;
+  switch (GetShorty()[shorty_index]) {
+    case 'Z':
+    case 'B':
+      return 1u;
+    case 'C':
+    case 'S':
+      return 2u;
+    case 'I':
+    case 'F':
+      return 4u;
+    case 'J':
+    case 'D':
+    case 'L':
+      return 8u;
+    default:
+      LOG(FATAL) << "Unexpected JNI shorty argument " << GetShorty()[shorty_index];
+      UNREACHABLE();
+  }
+}
+
+bool Arm64JniCallingConvention::DarwinCurrentParamOnStack() const {
+  const size_t gp_index = itr_args_ - itr_float_and_doubles_;
+  const size_t fp_index = itr_float_and_doubles_;
+  const size_t extra = NumberOfExtraArgumentsForJni();
+  bool is_fp = false;
+  if (itr_args_ >= extra) {
+    const size_t arg = itr_args_ - extra;
+    if (IsStatic() || arg != 0u) {
+      const size_t shorty_index = IsStatic() ? arg + 1u : arg;
+      const char type = GetShorty()[shorty_index];
+      is_fp = type == 'F' || type == 'D';
+    }
+  }
+  return is_fp ? fp_index >= kMaxFloatOrDoubleRegisterArguments
+               : gp_index >= kMaxIntLikeRegisterArguments;
+}
+#endif
+
+void Arm64JniCallingConvention::ResetIterator(FrameOffset displacement) {
+  JniCallingConvention::ResetIterator(displacement);
+#if defined(__APPLE__)
+  darwin_stack_offset_ = 0u;
+#endif
+}
+
+void Arm64JniCallingConvention::Next() {
+#if defined(__APPLE__)
+  if (DarwinCurrentParamOnStack()) {
+    const size_t size = DarwinCurrentParamSize();
+    darwin_stack_offset_ = RoundUp(darwin_stack_offset_, size) + size;
+  }
+#endif
+  JniCallingConvention::Next();
+}
+
+size_t Arm64JniCallingConvention::CurrentParamSize() const {
+#if defined(__APPLE__)
+  if (DarwinCurrentParamOnStack()) return DarwinCurrentParamSize();
+#endif
+  return JniCallingConvention::CurrentParamSize();
+}
 
 uint32_t Arm64JniCallingConvention::CoreSpillMask() const {
   return is_critical_native_ ? 0u : kCoreCalleeSpillMask;
@@ -294,5 +363,37 @@ size_t Arm64JniCallingConvention::OutFrameSize() const {
   size_t num_non_fp_args = all_args - num_fp_args;
   // The size of outgoing arguments.
+#if defined(__APPLE__)
+  size_t size = 0u;
+  size_t gp_args = 0u;
+  size_t fp_args = 0u;
+  auto add_argument = [&](char type) {
+    const bool is_fp = type == 'F' || type == 'D';
+    const bool in_register = is_fp ? fp_args++ < kMaxFloatOrDoubleRegisterArguments
+                                   : gp_args++ < kMaxIntLikeRegisterArguments;
+    if (in_register) return;
+    size_t arg_size;
+    switch (type) {
+      case 'Z':
+      case 'B': arg_size = 1u; break;
+      case 'C':
+      case 'S': arg_size = 2u; break;
+      case 'I':
+      case 'F': arg_size = 4u; break;
+      case 'J':
+      case 'D':
+      case 'L': arg_size = 8u; break;
+      default: LOG(FATAL) << "Unexpected JNI shorty argument " << type; UNREACHABLE();
+    }
+    size = RoundUp(size, arg_size) + arg_size;
+  };
+  if (!IsCriticalNative()) {
+    add_argument('L');  // JNIEnv*.
+    if (IsStatic()) add_argument('L');  // jclass.
+  }
+  if (!IsStatic()) add_argument('L');  // jobject receiver.
+  for (char type : GetShorty().substr(1u)) add_argument(type);
+#else
   size_t size = GetNativeOutArgsSize(num_fp_args, num_non_fp_args);
+#endif
 
   // @CriticalNative can use tail call as all managed callee saves are preserved by AAPCS64.
@@ -375,10 +476,16 @@ FrameOffset Arm64JniCallingConvention::CurrentParamStackOffset() {
   CHECK(IsCurrentParamOnStack());
+#if defined(__APPLE__)
+  const size_t size = DarwinCurrentParamSize();
+  const size_t packed_offset = RoundUp(darwin_stack_offset_, size);
+  size_t offset = displacement_.Int32Value() - OutFrameSize() + packed_offset;
+#else
   size_t args_on_stack = itr_args_
                   - std::min(kMaxFloatOrDoubleRegisterArguments,
                              static_cast<size_t>(itr_float_and_doubles_))
                   - std::min(kMaxIntLikeRegisterArguments,
                              static_cast<size_t>(itr_args_ - itr_float_and_doubles_));
   size_t offset = displacement_.Int32Value() - OutFrameSize() + (args_on_stack * kFramePointerSize);
+#endif
   CHECK_LT(offset, OutFrameSize());
   return FrameOffset(offset);
 }
