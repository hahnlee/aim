   UseScratchRegisterScope temps(asm_.GetVIXLAssembler());
-  Register scratch = (size == 8) ? temps.AcquireX() : temps.AcquireW();
-  ___ Ldr(scratch, MEM_OP(reg_x(SP), src.Int32Value()));
