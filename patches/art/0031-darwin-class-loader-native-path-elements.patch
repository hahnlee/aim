diff --git a/runtime/class_linker.cc b/runtime/class_linker.cc
--- a/runtime/class_linker.cc
+++ b/runtime/class_linker.cc
@@ -11085,6 +11085,22 @@
     //       is fine for testing. While it violates a Java-code invariant, as
     //       long as one does not try to add elements, this will still
     //       work.
     native_lib_dirs->SetObject<false>(h_dex_path_list.Get(), list_object);
+
+    // CreatePathClassLoader is a bootstrap/test helper rather than the Java
+    // BaseDexClassLoader constructor, so DexPathList's native-library element
+    // array is otherwise left null. Android's addNativePath() appends to
+    // that array before Runtime.loadLibrary0 calls findLibrary(); seed the
+    // same empty array the normal constructor would have produced.
+    ArtField* native_lib_path_elements = dex_elements_field->GetDeclaringClass()->
+        FindDeclaredInstanceField(
+            "nativeLibraryPathElements",
+            "[Ldalvik/system/DexPathList$NativeLibraryElement;");
+    DCHECK(native_lib_path_elements != nullptr);
+    ObjPtr<mirror::ObjectArray<mirror::Object>> empty_native_lib_elements =
+        mirror::ObjectArray<mirror::Object>::Alloc(
+            self, native_lib_path_elements->ResolveType(), 0);
+    native_lib_path_elements->SetObject<false>(
+        h_dex_path_list.Get(), empty_native_lib_elements);
   }
