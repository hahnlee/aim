--- a/runtime/gc/collector/semi_space.cc
+++ b/runtime/gc/collector/semi_space.cc
@@ -40,6 +40,8 @@
 #include "indirect_reference_table.h"
 #include "intern_table.h"
+#include "jit/jit.h"
+#include "jit/jit_code_cache.h"
 #include "jni/jni_internal.h"
 #include "mark_sweep-inl.h"
 #include "mirror/object-inl.h"
 #include "mirror/object-refvisitor-inl.h"
@@ -502,6 +504,13 @@
 void SemiSpace::SweepSystemWeaks() {
   TimingLogger::ScopedTiming t(__FUNCTION__, GetTimings());
   Runtime* runtime = Runtime::Current();
   runtime->SweepSystemWeaks(this);
+  // Homogeneous compaction moves objects even when the configured collector
+  // is non-moving. Runtime::SweepSystemWeaks uses that configured collector
+  // for its JIT-table gate, so cover this otherwise skipped moving pass.
+  // Avoid a second sweep when Runtime already updated the table.
+  if (runtime->GetJit() != nullptr && !runtime->GetHeap()->IsMovingGc()) {
+    runtime->GetJit()->GetCodeCache()->SweepRootTables(this);
+  }
   runtime->GetThreadList()->ClearInterpreterCaches();
 }
