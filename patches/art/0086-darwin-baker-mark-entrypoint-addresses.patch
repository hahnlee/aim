diff --git a/runtime/arch/arm64/quick_entrypoints_arm64.S b/runtime/arch/arm64/quick_entrypoints_arm64.S
--- a/runtime/arch/arm64/quick_entrypoints_arm64.S
+++ b/runtime/arch/arm64/quick_entrypoints_arm64.S
@@ -2116,7 +2116,13 @@
     // Reference is null, no work to do at all.
     cbz \wreg, .Lret_rb_\name
     // Use wIP0 as temp and check the mark bit of the reference. wIP0 is not used by the compiler.
+#if defined(__APPLE__)
+    mov   xIP0, #AIM_REFERENCE_BASE
+    add   xIP0, xIP0, \wreg, uxtw
+    ldr   wIP0, [xIP0, #MIRROR_OBJECT_LOCK_WORD_OFFSET]
+#else
     ldr   wIP0, [\xreg, #MIRROR_OBJECT_LOCK_WORD_OFFSET]
+#endif
     tbz   wIP0, #LOCK_WORD_MARK_BIT_SHIFT, .Lnot_marked_rb_\name
 .Lret_rb_\name:
     ret
@@ -2125,6 +2131,10 @@
     tst   wIP0, wIP0, lsl #1
     bmi   .Lret_forwarding_address\name
 .Lslow_rb_\name:
+#if defined(__APPLE__)
+    mov   xIP0, #AIM_REFERENCE_BASE
+    add   xIP0, xIP0, \wreg, uxtw
+#endif
     /*
      * Allocate 44 stack slots * 8 = 352 bytes:
      * - 19 slots for core registers X0-15, X17, X19, LR
@@ -2158,13 +2168,27 @@
     stp   d28, d29, [sp, #320]
     stp   d30, d31, [sp, #336]
 
+#if defined(__APPLE__)
+    mov   x0, xIP0                    // Pass a native Object* to C++.
+#else
     .ifnc \wreg, w0
       mov   w0, \wreg                   // Pass arg1 - obj from `wreg`
     .endif
+#endif
     CALL_SYMBOL artReadBarrierMark      // artReadBarrierMark(obj)
+#if defined(__APPLE__)
+    mov   xIP0, #AIM_REFERENCE_BASE
+    sub   xIP0, x0, xIP0              // Return a compressed managed reference.
+    .ifnc \wreg, w0
+      mov   \wreg, wIP0
+    .else
+      mov   w0, wIP0
+    .endif
+#else
     .ifnc \wreg, w0
       mov   \wreg, w0                   // Return result into `wreg`
     .endif
+#endif
 
     // Restore core regs, except `xreg`, as `wreg` is used to return the
     // result of this function (simply remove it from the stack instead).
@@ -2487,6 +2511,12 @@
     .global art_quick_read_barrier_mark_introspection_gc_roots
 art_quick_read_barrier_mark_introspection_gc_roots:
 #endif
+#if defined(__APPLE__)
+    // The GC-root thunk carries a compressed32 reference in IP0. Unlike the
+    // main entry, this fixed-offset entry jumps directly to the slow path.
+    mov   xIP1, #AIM_REFERENCE_BASE
+    add   xIP0, xIP1, wIP0, uxtw
+#endif
     READ_BARRIER_MARK_INTROSPECTION_SLOW_PATH BAKER_MARK_INTROSPECTION_GC_ROOT_LDR_OFFSET
 #if defined(__APPLE__)
 .Ldarwin_mark_introspection:
