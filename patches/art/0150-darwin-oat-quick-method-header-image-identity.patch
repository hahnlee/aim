diff --git a/runtime/oat/oat_quick_method_header.cc b/runtime/oat/oat_quick_method_header.cc
--- a/runtime/oat/oat_quick_method_header.cc
+++ b/runtime/oat/oat_quick_method_header.cc
@@ -19,5 +19,10 @@
 #include <optional>
 
-#ifndef __APPLE__
+#ifdef __APPLE__
+#include <dlfcn.h>
+#include <mach-o/loader.h>
+#include <cstring>
+#include <utility>
+#else
 #include <link.h>  // for dl_iterate_phdr.
 #endif
@@ -172,9 +176,42 @@
 // Check if the current method header is in libart.
 std::optional<bool> OatQuickMethodHeader::IsStub(const uint8_t* pc) {
 #ifndef __APPLE__
   static ArrayRef<const uint8_t> libart_code = FindLibartCode();
   return libart_code.begin() <= pc && pc < libart_code.end();
 #else
-  return std::nullopt;
+  // The runtime stubs live in the __TEXT segment of the same Mach-O image as
+  // Runtime::Current. Resolve that segment once. Stack walking and exception
+  // delivery call IsStub for every frame, so querying dyld with dladdr for
+  // every PC is prohibitively expensive for exception-heavy tests and is not
+  // needed once the immutable image range is known.
+  static const std::pair<uintptr_t, uintptr_t> libart_text = []
+      -> std::pair<uintptr_t, uintptr_t> {
+    Dl_info runtime_image{};
+    const void* runtime_entry = reinterpret_cast<const void*>(
+        reinterpret_cast<uintptr_t>(Runtime::Current));
+    CHECK(dladdr(runtime_entry, &runtime_image) != 0)
+        << "Can not find libart image in memory";
+    CHECK(runtime_image.dli_fbase != nullptr)
+        << "libart image has no load address";
+    auto* header = reinterpret_cast<const mach_header_64*>(runtime_image.dli_fbase);
+    CHECK_EQ(header->magic, MH_MAGIC_64);
+    auto* command = reinterpret_cast<const load_command*>(header + 1);
+    for (uint32_t i = 0; i != header->ncmds; ++i) {
+      if (command->cmd == LC_SEGMENT_64) {
+        auto* segment = reinterpret_cast<const segment_command_64*>(command);
+        if (std::strncmp(segment->segname, "__TEXT", sizeof(segment->segname)) == 0) {
+          uintptr_t begin = reinterpret_cast<uintptr_t>(runtime_image.dli_fbase) +
+              segment->vmaddr;
+          return std::make_pair(begin, begin + segment->vmsize);
+        }
+      }
+      command = reinterpret_cast<const load_command*>(
+          reinterpret_cast<const uint8_t*>(command) + command->cmdsize);
+    }
+    CHECK(false) << "Can not find libart __TEXT segment";
+    return std::make_pair(uintptr_t{0}, uintptr_t{0});
+  }();
+  uintptr_t address = reinterpret_cast<uintptr_t>(pc);
+  return libart_text.first <= address && address < libart_text.second;
 #endif
 }
