diff --git a/runtime/runtime_common.cc b/runtime/runtime_common.cc
--- a/runtime/runtime_common.cc
+++ b/runtime/runtime_common.cc
@@ -394,6 +394,20 @@ static void HandleUnexpectedSignalCommonDump(int signal_number,
     }
     pid_t tid = GetTid();
     std::string thread_name(GetThreadName(tid));
+#if defined(__APPLE__) && defined(__aarch64__)
+    // Darwin can deliver a synthetic signal with no machine context (for
+    // example after a chained handler re-raises it).  ART's Linux UContext
+    // wrapper dereferences uc_mcontext unconditionally; guard that boundary
+    // so a diagnostic second fault cannot hide the original application
+    // signal.
+    const ucontext_t* darwin_context = reinterpret_cast<const ucontext_t*>(raw_context);
+    if (darwin_context == nullptr || darwin_context->uc_mcontext == nullptr) {
+      stream << "ART signal context unavailable (Darwin uc_mcontext=null) signal="
+             << signal_number << " fault addr " << (info == nullptr ? nullptr : info->si_addr)
+             << std::endl;
+      return;
+    }
+#endif
     UContext thread_context(raw_context);
     Backtrace thread_backtrace(raw_context);
