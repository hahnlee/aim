diff --git a/runtime/gc/space/rosalloc_space.cc b/runtime/gc/space/rosalloc_space.cc
--- a/runtime/gc/space/rosalloc_space.cc
+++ b/runtime/gc/space/rosalloc_space.cc
@@ -427,6 +427,12 @@
 void RosAllocSpace::Clear() {
   size_t footprint_limit = GetFootprintLimit();
   madvise(GetMemMap()->Begin(), GetMemMap()->Size(), MADV_DONTNEED);
+  if (!kMadviseZeroes) {
+    // RosAlloc explicitly clears its complete capacity during construction.
+    // The unused tail is normally PROT_NONE, so make the owned map writable
+    // for that operation and restore the guard after reconstruction.
+    CHECK(GetMemMap()->Protect(PROT_READ | PROT_WRITE));
+  }
   live_bitmap_.Clear();
   mark_bitmap_.Clear();
   SetEnd(begin_ + starting_size_);
@@ -437,5 +443,12 @@
                              NonGrowthLimitCapacity(),
                              low_memory_mode_,
                              Runtime::Current()->IsRunningOnMemoryTool());
+  if (!kMadviseZeroes && NonGrowthLimitCapacity() > starting_size_) {
+    CheckedCall(mprotect,
+                GetName(),
+                begin_ + starting_size_,
+                NonGrowthLimitCapacity() - starting_size_,
+                PROT_NONE);
+  }
   SetFootprintLimit(footprint_limit);
 }
