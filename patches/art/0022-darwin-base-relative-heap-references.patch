diff --git a/runtime/mirror/object_reference.h b/runtime/mirror/object_reference.h
--- a/runtime/mirror/object_reference.h
+++ b/runtime/mirror/object_reference.h
@@ -97,12 +97,24 @@ class PtrCompression {
  public:
   // Compress reference to its bit representation.
   static uint32_t Compress(MirrorType* mirror_ptr) {
-    uint32_t as_bits = reinterpret_cast32<uint32_t>(mirror_ptr);
+    uintptr_t address = reinterpret_cast<uintptr_t>(mirror_ptr);
+    uint32_t as_bits;
+    if (address == 0u) {
+      as_bits = 0u;
+    } else {
+      DCHECK_GE(address, kArtCompressedReferenceBase);
+      DCHECK_LT(address, kArtCompressedReferenceLimit);
+      as_bits = static_cast<uint32_t>(address - kArtCompressedReferenceBase);
+      DCHECK_NE(as_bits, 0u);
+    }
     return kPoisonReferences ? -as_bits : as_bits;
   }
 
   // Uncompress an encoded reference from its bit representation.
   static MirrorType* Decompress(uint32_t ref) {
     uint32_t as_bits = kPoisonReferences ? -ref : ref;
-    return reinterpret_cast32<MirrorType*>(as_bits);
+    if (as_bits == 0u) {
+      return nullptr;
+    }
+    return reinterpret_cast<MirrorType*>(kArtCompressedReferenceBase + as_bits);
   }
diff --git a/runtime/gc/heap.cc b/runtime/gc/heap.cc
--- a/runtime/gc/heap.cc
+++ b/runtime/gc/heap.cc
@@ -205,10 +205,10 @@ static constexpr uint32_t kAllocSpaceBeginForDeterministicAoT = 0x40000000;
 #if defined(__LP64__) || !defined(ADDRESS_SANITIZER)
 // 32 MB (0x2000000) is picked to ensure it is aligned to the largest supported PMD
 // size, which is 32mb with a 16k page size on AArch64.
 uint8_t* const Heap::kPreferredAllocSpaceBegin = reinterpret_cast<uint8_t*>(([]() constexpr {
-  constexpr size_t kBegin = 32 * MB;
+  constexpr uintptr_t kBegin = kArtCompressedReferenceBase + 32 * MB;
   constexpr int kMaxPMDSize = (kMaxPageSize / sizeof(uint64_t)) * kMaxPageSize;
   static_assert(IsAligned<kMaxPMDSize>(kBegin),
                 "Moving-space's begin should be aligned to the maximum supported PMD size.");
   return kBegin;
 })());
@@ -723,11 +723,11 @@ Heap::Heap(size_t initial_size,
   // Allocate the card table.
   // We currently don't support dynamically resizing the card table.
   // Since we don't know where in the low_4gb the app image will be located, make the card table
   // cover the whole low_4gb. TODO: Extend the card table in AddSpace.
   UNUSED(heap_capacity);
-  // Start at 4 KB, we can be sure there are no spaces mapped this low since the address range is
-  // reserved by the kernel.
-  static constexpr size_t kMinHeapAddress = 4 * KB;
+  // Offset zero is the null compressed reference, so the managed window starts one page above
+  // its base. On Darwin the entire window is above the mandatory 4GB __PAGEZERO.
+  static constexpr uintptr_t kMinHeapAddress = kArtCompressedReferenceBase + 4 * KB;
   card_table_.reset(accounting::CardTable::Create(reinterpret_cast<uint8_t*>(kMinHeapAddress),
-                                                  4 * GB - kMinHeapAddress));
+                                                  kArtCompressedReferenceLimit - kMinHeapAddress));
   CHECK(card_table_.get() != nullptr) << "Failed to create card table";
