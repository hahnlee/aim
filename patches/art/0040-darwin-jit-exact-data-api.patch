diff --git a/runtime/jit/jit_memory_region.cc b/runtime/jit/jit_memory_region.cc
--- a/runtime/jit/jit_memory_region.cc
+++ b/runtime/jit/jit_memory_region.cc
@@ -103,37 +103,37 @@
-    // XNU rejects MAP_JIT|MAP_FIXED (EINVAL), so allocate executable memory
-    // first without a reservation. A non-JIT metadata mapping is then hinted
-    // below it; the complete pair is checked against ART's uint32 offset
-    // contract before either view is published.
-    std::string name = exec_cache_name + "-rwx";
-    exec_pages = MemMap::MapFileAtAddress(nullptr,
-                                          exec_capacity,
-                                 kProtRWX,
-                                 MAP_PRIVATE | MAP_ANON | MAP_JIT,
-                                 -1,
-                                 /* start= */ 0,
-                                 /* low_4gb= */ false,
-                                          name.c_str(),
-                                          /* reuse= */ false,
-                                          nullptr,
-                                          &error_str);
-    if (!exec_pages.IsValid()) {
-      *error_msg = "Failed to create Darwin MAP_JIT code cache: " + error_str;
-      return false;
-    }
-    data_pages = MemMap::MapAnonymous(data_cache_name.c_str(), nullptr,
-                                      data_capacity, kProtRW, false, false,
-                                      nullptr, &error_str);
-    if (!data_pages.IsValid()) {
-      exec_pages.Reset();
-      *error_msg = "Failed to map Darwin JIT data cache: " + error_str;
-      return false;
-    }
-    const uintptr_t data_begin = reinterpret_cast<uintptr_t>(data_pages.Begin());
-    const uintptr_t exec_begin = reinterpret_cast<uintptr_t>(exec_pages.Begin());
-    const uintptr_t exec_end = reinterpret_cast<uintptr_t>(exec_pages.End());
-    if (data_begin > exec_begin || exec_end - data_begin > UINT32_MAX) {
-      data_pages.Reset();
-      exec_pages.Reset();
-      *error_msg = "Darwin JIT data/code mappings exceed uint32 offset range";
-      return false;
-    }
+    // Reserve metadata first. MAP_JIT must not consume a MemMap reservation:
+    // that API adds MAP_FIXED, which XNU rejects for MAP_JIT mappings.
+    std::string name = exec_cache_name + "-rwx";
+    MemMap reservation = MemMap::MapAnonymous(
+        "Darwin JIT metadata reservation", nullptr, data_capacity, PROT_NONE,
+        false, false, nullptr, &error_str);
+    if (!reservation.IsValid()) {
+      *error_msg = "Darwin JIT metadata reservation failed: " + error_str;
+      return false;
+    }
+    exec_pages = MemMap::MapFileAtAddress(
+        nullptr, exec_capacity, kProtRWX, MAP_PRIVATE | MAP_ANON | MAP_JIT,
+        -1, 0, false, name.c_str(), false, nullptr, &error_str);
+    if (!exec_pages.IsValid()) {
+      *error_msg = "Darwin MAP_JIT after reservation failed: " + error_str;
+      return false;
+    }
+    const uintptr_t data_begin = reinterpret_cast<uintptr_t>(reservation.Begin());
+    const uintptr_t data_end = reinterpret_cast<uintptr_t>(reservation.End());
+    const uintptr_t exec_begin = reinterpret_cast<uintptr_t>(exec_pages.Begin());
+    const uintptr_t exec_end = reinterpret_cast<uintptr_t>(exec_pages.End());
+    if (data_end > exec_begin || exec_end < data_begin ||
+        exec_end - data_begin > UINT32_MAX) {
+      *error_msg = "Darwin JIT reserved pair out of range data=" +
+          std::to_string(data_begin) + ".." + std::to_string(data_end) +
+          " exec=" + std::to_string(exec_begin) + ".." + std::to_string(exec_end);
+      return false;
+    }
+    // MAP_FIXED is safe here: only our owned non-JIT reservation is replaced.
+    // On success MemMap transfers ownership from reservation into data_pages.
+    data_pages = MemMap::MapAnonymous(
+        data_cache_name.c_str(), reservation.Begin(), data_capacity, kProtRW,
+        false, false, &reservation, &error_str);
+    if (!data_pages.IsValid()) {
+      *error_msg = "Darwin JIT reserved metadata commit failed: " + error_str;
+      return false;
+    }
