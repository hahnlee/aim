diff --git a/runtime/runtime_common.cc b/runtime/runtime_common.cc
--- a/runtime/runtime_common.cc
+++ b/runtime/runtime_common.cc
@@ -18,6 +18,7 @@
 #include "runtime_common.h"
 
 #include <signal.h>
+#include <unistd.h>
 
 #if defined(__APPLE__) && defined(__aarch64__)
 #include <mach/arm/thread_status.h>
@@ -485,6 +486,42 @@ void HandleUnexpectedSignalCommon(int signal_number,
                                   void* raw_context,
                                   bool handle_timeout_signal,
                                   bool dump_on_stderr) {
+#if defined(__APPLE__) && defined(__aarch64__)
+  // Several mutators can fault together under ThreadStress. Emit the first
+  // useful coordinate with async-signal-safe write() before taking ART locks
+  // or constructing C++ streams, so a second fault cannot hide the first one.
+  ucontext_t* darwin_ucontext = reinterpret_cast<ucontext_t*>(raw_context);
+  if (darwin_ucontext != nullptr && darwin_ucontext->uc_mcontext != nullptr && info != nullptr) {
+  char line[256];
+  size_t used = 0u;
+  constexpr char prefix[] = "ART unexpected signal ";
+  for (size_t i = 0u; i != sizeof(prefix) - 1u; ++i) line[used++] = prefix[i];
+  if (signal_number >= 10) line[used++] = '0' + (signal_number / 10) % 10;
+  line[used++] = '0' + signal_number % 10;
+  auto append_hex = [&](const char* label, uintptr_t value) {
+    while (*label != '\0') line[used++] = *label++;
+    bool emitted = false;
+    for (int shift = static_cast<int>(sizeof(value) * 8u) - 4; shift >= 0; shift -= 4) {
+      unsigned digit = (value >> shift) & 0xfu;
+      if (digit != 0u || emitted || shift == 0) {
+        line[used++] = digit < 10u ? '0' + digit : 'a' + digit - 10u;
+        emitted = true;
+      }
+    }
+  };
+  arm_thread_state64_t& state =
+      reinterpret_cast<ucontext_t*>(raw_context)->uc_mcontext->__ss;
+  append_hex(" pc=0x", arm_thread_state64_get_pc(state));
+  append_hex(" anchor=0x", reinterpret_cast<uintptr_t>(&HandleUnexpectedSignalCommon));
+  append_hex(" addr=0x", reinterpret_cast<uintptr_t>(info->si_addr));
+  append_hex(" x0=0x", state.__x[0]);
+  append_hex(" x16=0x", state.__x[16]);
+  append_hex(" x21=0x", state.__x[21]);
+  line[used++] = '\n';
+  ssize_t ignored = write(STDERR_FILENO, line, used);
+  (void)ignored;
+  }
+#endif
   bool runtime_abort = gIsRuntimeAbort.exchange(false);
   if (runtime_abort) {
     return;
