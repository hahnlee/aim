diff --git a/compiler/optimizing/code_generator_arm64.cc b/compiler/optimizing/code_generator_arm64.cc
--- a/compiler/optimizing/code_generator_arm64.cc
+++ b/compiler/optimizing/code_generator_arm64.cc
@@ -1423,5 +1423,20 @@ void CodeGeneratorARM64::GenerateFrameEntry() {
   MacroAssembler* masm = GetVIXLAssembler();
 
+#if defined(__APPLE__)
+  // AOSP's managed ABI carries an absolute ArtMethod* in x0. Image method
+  // relocations are 32-bit logical addresses on Android; lift that value into
+  // Darwin's managed window before any clinit access or frame publication.
+  {
+    UseScratchRegisterScope temps(masm);
+    Register upper = temps.AcquireX();
+    vixl::aarch64::Label native_method;
+    __ Lsr(upper, kArtMethodRegister, 32u);
+    __ Cbnz(upper, &native_method);
+    __ Orr(kArtMethodRegister, kArtMethodRegister, kArtCompressedReferenceBase);
+    __ Bind(&native_method);
+  }
+#endif
+
   // Check if we need to generate the clinit check. We will jump to the
   // resolution stub if the class is not initialized and the executing thread is
   // not the thread initializing it.
diff --git a/compiler/optimizing/code_generator_arm64.cc b/compiler/optimizing/code_generator_arm64.cc
--- a/compiler/optimizing/code_generator_arm64.cc
+++ b/compiler/optimizing/code_generator_arm64.cc
@@ -4998,4 +4998,17 @@ void CodeGeneratorARM64::LoadMethod(MethodLoadKind load_kind, Location temp, HInvoke* invoke) {
       vixl::aarch64::Label* add_label =
           NewBootImageMethodPatch(invoke->GetResolvedMethodReference(), adrp_label);
       EmitAddPlaceholder(add_label, XRegisterFrom(temp), XRegisterFrom(temp));
+#if defined(__APPLE__)
+      // Boot-image method patches carry Android's 32-bit logical address;
+      // convert it to the native Darwin metadata pointer before use.
+      {
+        UseScratchRegisterScope temps(GetVIXLAssembler());
+        Register upper = temps.AcquireX();
+        vixl::aarch64::Label native_method;
+        __ Lsr(upper, XRegisterFrom(temp), 32u);
+        __ Cbnz(upper, &native_method);
+        __ Orr(XRegisterFrom(temp), XRegisterFrom(temp), kArtCompressedReferenceBase);
+        __ Bind(&native_method);
+      }
+#endif
       break;
