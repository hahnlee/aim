diff --git a/runtime/plugin.cc b/runtime/plugin.cc
--- a/runtime/plugin.cc
+++ b/runtime/plugin.cc
@@ -40,6 +40,17 @@ bool Plugin::Load(/*out*/std::string* error_msg) {
   DCHECK(!IsLoaded());
   void* res = dlopen(library_.c_str(), RTLD_LAZY);
+#if defined(__APPLE__)
+  // aim embeds OpenJDK JVMTI in the runtime image so the plugin can
+  // consume ART-private C++ symbols without exporting that unstable ABI
+  // across dylibs. Preserve Android's named Plugin contract, but resolve the
+  // one embedded platform plugin through the current process image.
+  if (res == nullptr &&
+      (library_ == "libopenjdkjvmti.so" || library_ == "libopenjdkjvmtid.so") &&
+      dlsym(RTLD_DEFAULT, PLUGIN_INITIALIZATION_FUNCTION_NAME) != nullptr) {
+    res = RTLD_DEFAULT;
+  }
+#endif
   if (res == nullptr) {
     *error_msg = StringPrintf("dlopen failed: %s", dlerror());
     return false;
   }
