diff --git a/runtime/arch/arm64/quick_entrypoints_arm64.S b/runtime/arch/arm64/quick_entrypoints_arm64.S
--- a/runtime/arch/arm64/quick_entrypoints_arm64.S
+++ b/runtime/arch/arm64/quick_entrypoints_arm64.S
@@ -34,6 +34,22 @@
     .cfi_adjust_cfa_offset -(\frame_adjustment)
 .endm
 
+.macro NORMALIZE_ART_METHOD_IN_X0
+#if defined(__APPLE__) && AIM_REFERENCE_BASE != 0
+    // Managed quick calls carry ArtMethod* as a low-32-bit logical address.
+    // Runtime metadata is native-addressed on Darwin; lift only that form
+    // before a frame stores x0 or a C++ bridge dereferences it. xIP0 is an
+    // intra-procedural scratch register and no flags are modified.
+    cbz    x0, 1f
+    mov    xIP0, x0
+    lsr    xIP0, xIP0, #32
+    cbnz   xIP0, 1f
+    mov    xIP0, #AIM_REFERENCE_BASE
+    orr    x0, x0, xIP0
+1:
+#endif
+.endm
+
 .macro POP_SAVE_REFS_ONLY_FRAME
     DECREASE_FRAME 96
 .endm
@@ -1640,7 +1657,8 @@
      */
      .extern artQuickProxyInvokeHandler
 ENTRY art_quick_proxy_invoke_handler
+    NORMALIZE_ART_METHOD_IN_X0
     SETUP_SAVE_REFS_AND_ARGS_FRAME_WITH_METHOD_IN_X0
     mov     x2, xSELF                            // pass Thread::Current
     mov     x3, sp                               // pass SP
     CALL_SYMBOL artQuickProxyInvokeHandler       // (Method* proxy method, receiver, Thread*, SP)
@@ -1690,4 +1707,5 @@
 END art_quick_proxy_invoke_handler
 
 ENTRY art_quick_resolution_trampoline
