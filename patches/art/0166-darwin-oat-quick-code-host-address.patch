diff --git a/runtime/oat/oat_file-inl.h b/runtime/oat/oat_file-inl.h
--- a/runtime/oat/oat_file-inl.h
+++ b/runtime/oat/oat_file-inl.h
@@ -94,5 +94,13 @@ inline const void* OatFile::OatMethod::GetQuickCode() const {
   if (code_offset_ == 0) {
     return nullptr;
   }
-  return reinterpret_cast<const void *>(begin_ + code_offset_);
+  uintptr_t code_address = reinterpret_cast<uintptr_t>(begin_) + code_offset_;
+#if defined(__APPLE__)
+  // OAT stores method code addresses in Android's logical 32-bit address
+  // window.  OatFile::Begin() can therefore still be logical when an image
+  // was loaded through the Darwin compatibility mapper; lift only low values
+  // below the window base and leave native host mappings unchanged.
+  code_address = ArtCompressedReferenceToHostAddress(code_address);
+#endif
+  return reinterpret_cast<const void *>(code_address);
 }
