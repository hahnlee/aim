diff --git a/runtime/thread.cc b/runtime/thread.cc
--- a/runtime/thread.cc
+++ b/runtime/thread.cc
@@ -23,6 +23,10 @@
 #include <sys/resource.h>
 #include <sys/time.h>
 
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#endif
+
 #include <algorithm>
 #include <atomic>
 #include <bitset>
@@ -1487,8 +1491,11 @@ uint64_t Thread::GetCpuMicroTime() const {
 #if defined(__linux__)
   return Thread::GetCpuNanoTime() / 1000;
-#else  // __APPLE__
+#elif defined(__APPLE__)
+  uint64_t nanos = Thread::GetCpuNanoTime();
+  return nanos == UINT64_MAX ? UINT64_MAX : nanos / 1000;
+#else
   UNIMPLEMENTED(WARNING);
-  return -1;
+  return UINT64_MAX;
 #endif
 }
 
@@ -1500,9 +1507,24 @@ uint64_t Thread::GetCpuNanoTime() const {
   clock_gettime(cpu_clock_id, &now);
   return static_cast<uint64_t>(now.tv_sec) * UINT64_C(1000000000) +
          static_cast<uint64_t>(now.tv_nsec);
-#else  // __APPLE__
+#elif defined(__APPLE__)
+  thread_basic_info_data_t info;
+  mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+  kern_return_t result = thread_info(pthread_mach_thread_np(tlsPtr_.pthread_self),
+                                     THREAD_BASIC_INFO,
+                                     reinterpret_cast<thread_info_t>(&info),
+                                     &count);
+  if (result != KERN_SUCCESS) {
+    return UINT64_MAX;
+  }
+  uint64_t seconds = static_cast<uint64_t>(info.user_time.seconds) +
+                     static_cast<uint64_t>(info.system_time.seconds);
+  uint64_t micros = static_cast<uint64_t>(info.user_time.microseconds) +
+                    static_cast<uint64_t>(info.system_time.microseconds);
+  return seconds * UINT64_C(1000000000) + micros * UINT64_C(1000);
+#else
   UNIMPLEMENTED(WARNING);
-  return -1;
+  return UINT64_MAX;
 #endif
 }
 
