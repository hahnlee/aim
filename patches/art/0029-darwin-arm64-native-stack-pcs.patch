 // Get stack args size for @CriticalNative method calls.
 inline size_t GetCriticalNativeCallArgsSize(std::string_view shorty) {
+#if defined(__APPLE__)
+  size_t num_fp_regs = 0u;
+  size_t num_gpr_regs = 0u;
+  size_t stack_size = 0u;
+  for (char type : shorty.substr(1u)) {
+    const bool fp = type == 'F' || type == 'D';
+    size_t& register_count = fp ? num_fp_regs : num_gpr_regs;
+    const size_t register_limit =
+        fp ? kMaxFloatOrDoubleRegisterArguments : kMaxIntLikeRegisterArguments;
+    if (register_count < register_limit) {
+      ++register_count;
+      continue;
+    }
+    const size_t size = type == 'D' || type == 'J' || type == 'L'
+                            ? sizeof(uint64_t)
+                        : type == 'C' || type == 'S' ? sizeof(uint16_t)
+                        : type == 'B' || type == 'Z' ? sizeof(uint8_t)
+                                                     : sizeof(uint32_t);
+    stack_size = RoundUp(stack_size, size);
+    stack_size += size;
+  }
+  return stack_size;
+#else
   size_t num_fp_args =
       std::count_if(shorty.begin() + 1, shorty.end(), [](char c) { return c == 'F' || c == 'D'; });
   size_t num_non_fp_args = shorty.length() - 1u - num_fp_args;

   return GetNativeOutArgsSize(num_fp_args, num_non_fp_args);
+#endif
 }

