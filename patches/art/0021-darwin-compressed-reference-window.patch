diff --git a/libartbase/base/globals.h b/libartbase/base/globals.h
--- a/libartbase/base/globals.h
+++ b/libartbase/base/globals.h
@@ -29,4 +29,52 @@ static constexpr size_t MB = KB * KB;
 static constexpr size_t GB = KB * KB * KB;
 
+// Android normally stores managed references as their absolute low 32 bits.
+// arm64 macOS enforces a hard 4GB __PAGEZERO, so reserve a 4GB-aligned high
+// window and store offsets from its base instead. Keeping the base at zero on
+// other hosts preserves upstream ART behavior.
+#if defined(__APPLE__) && defined(__LP64__)
+// Keep the fixed window away from Darwin's randomized default malloc zones,
+// which frequently occupy addresses in the first few dozen GiB.
+static constexpr uintptr_t kArtCompressedReferenceBase = 0x0000010000000000ULL;
+#else
+static constexpr uintptr_t kArtCompressedReferenceBase = 0u;
+#endif
+static constexpr uintptr_t kArtCompressedReferenceLimit =
+    kArtCompressedReferenceBase + 4ULL * GB;
+
+// ART image files keep Android's 32-bit logical addresses on Darwin. Convert
+// those addresses only at the mmap/loader boundary; managed compressed
+// references continue to contain the same 32-bit value as an Android image.
+ALWAYS_INLINE constexpr uintptr_t ArtCompressedReferenceToHostAddress(uintptr_t address) {
+#if defined(__APPLE__) && defined(__LP64__)
+  return address != 0u && address < 4ULL * GB
+      ? kArtCompressedReferenceBase + address
+      : address;
+#else
+  return address;
+#endif
+}
+
+ALWAYS_INLINE constexpr uintptr_t ArtHostAddressToCompressedReferenceAddress(uintptr_t address) {
+#if defined(__APPLE__) && defined(__LP64__)
+  return address >= kArtCompressedReferenceBase && address < kArtCompressedReferenceLimit
+      ? address - kArtCompressedReferenceBase
+      : address;
+#else
+  return address;
+#endif
+}
+#if defined(__APPLE__) && defined(__LP64__)
+// Reserve the complete logical Android low-4GB range at a high Darwin host
+// address. This consumes address space only; pages remain uncommitted until
+// an ART mapping replaces or enables a subrange. A partial arena rejects
+// valid AOSP boot-image addresses such as 0x70000000.
+static constexpr uintptr_t kArtManagedArenaBase =
+    kArtCompressedReferenceBase;
+static constexpr size_t kArtManagedArenaSize = 4ULL * GB;
+static constexpr uintptr_t kArtManagedArenaLimit =
+    kArtManagedArenaBase + kArtManagedArenaSize;
+#endif
+
 // Runtime sizes.
 static constexpr size_t kBitsPerByte = 8;
diff --git a/libartbase/base/mem_map.cc b/libartbase/base/mem_map.cc
--- a/libartbase/base/mem_map.cc
+++ b/libartbase/base/mem_map.cc
@@ -143,6 +143,6 @@ static uintptr_t GenerateNextMemPos(size_t page_size) {
 #else
   UNUSED(page_size);
   // No arc4random on host, see above.
-  return LOW_MEM_START;
+  return kArtCompressedReferenceBase + LOW_MEM_START;
 #endif
 }
@@ -198,6 +198,10 @@ bool MemMap::CheckMapRequest(uint8_t* expected_ptr, void* actual_ptr, size_t byte_count,
     return true;
   }
 
+#if defined(__APPLE__) && defined(__LP64__)
+  expected_ptr = reinterpret_cast<uint8_t*>(
+      ArtCompressedReferenceToHostAddress(reinterpret_cast<uintptr_t>(expected_ptr)));
+#endif
   uintptr_t actual = reinterpret_cast<uintptr_t>(actual_ptr);
   uintptr_t expected = reinterpret_cast<uintptr_t>(expected_ptr);
 
@@ -1184,11 +1184,17 @@ void* MemMap::MapInternal(void* addr,
 #ifdef __LP64__
   // When requesting low_4g memory and having an expectation, the requested range should fit into
-  // 4GB.
+  // the 4GB compressed-reference window. Darwin cannot map the literal low 4GB because the
+  // arm64 Mach-O loader enforces a hard __PAGEZERO over that entire range.
+  const uintptr_t logical_requested = reinterpret_cast<uintptr_t>(addr);
+  const uintptr_t requested = low_4gb
+      ? ArtCompressedReferenceToHostAddress(logical_requested)
+      : logical_requested;
+  addr = reinterpret_cast<void*>(requested);
   if (low_4gb && (
       // Start out of bounds.
-      (reinterpret_cast<uintptr_t>(addr) >> 32) != 0 ||
+      (addr != nullptr && requested < kArtCompressedReferenceBase) ||
       // End out of bounds. For simplicity, this will fail for the last page of memory.
-      ((reinterpret_cast<uintptr_t>(addr) + length) >> 32) != 0)) {
+      requested > kArtCompressedReferenceLimit - length)) {
     LOG(ERROR) << "The requested address space (" << addr << ", "
                << reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(addr) + length)
                << ") cannot fit in low_4gb";
