diff --git a/libartbase/base/time_utils.cc b/libartbase/base/time_utils.cc
--- a/libartbase/base/time_utils.cc
+++ b/libartbase/base/time_utils.cc
@@ -29,5 +29,7 @@
 #include "logging.h"
 
 #if defined(__APPLE__)
+#include <mach/mach.h>
+#include <pthread.h>
 #include <sys/time.h>
 #endif
@@ -191,10 +193,25 @@ uint64_t ThreadCpuNanoTime() {
 #if defined(__linux__)
   timespec now;
   clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now);
   return static_cast<uint64_t>(now.tv_sec) * UINT64_C(1000000000) + now.tv_nsec;
+#elif defined(__APPLE__)
+  thread_basic_info_data_t info;
+  mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+  kern_return_t result = thread_info(pthread_mach_thread_np(pthread_self()),
+                                     THREAD_BASIC_INFO,
+                                     reinterpret_cast<thread_info_t>(&info),
+                                     &count);
+  if (result != KERN_SUCCESS) {
+    return UINT64_MAX;
+  }
+  uint64_t seconds = static_cast<uint64_t>(info.user_time.seconds) +
+                     static_cast<uint64_t>(info.system_time.seconds);
+  uint64_t micros = static_cast<uint64_t>(info.user_time.microseconds) +
+                    static_cast<uint64_t>(info.system_time.microseconds);
+  return seconds * UINT64_C(1000000000) + micros * UINT64_C(1000);
 #else
   UNIMPLEMENTED(WARNING);
   return -1;
 #endif
 }
