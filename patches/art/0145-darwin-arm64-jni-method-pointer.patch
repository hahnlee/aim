   ArrayRef<const ManagedRegister> callee_save_regs = main_jni_conv->CalleeSaveRegisters();
   __ BuildFrame(current_frame_size, method_register, callee_save_regs);
   DCHECK_EQ(jni_asm->cfi().GetCurrentCFAOffset(), static_cast<int>(current_frame_size));
diff --git a/compiler/optimizing/fast_compiler_arm64.cc b/compiler/optimizing/fast_compiler_arm64.cc
--- a/compiler/optimizing/fast_compiler_arm64.cc
+++ b/compiler/optimizing/fast_compiler_arm64.cc
@@ -646,3 +646,16 @@ bool FastCompilerARM64::EnsureHasFrame() {
   //      sp[0]                     : current method.
   int32_t frame_size = GetFrameSize();
+#if defined(__APPLE__)
+  // Fast baseline code receives the same logical 32-bit ArtMethod address as
+  // optimizing code. Normalize it before the frame stores x0 at sp[0].
+  {
+    UseScratchRegisterScope temps(masm);
+    Register upper = temps.AcquireX();
+    vixl::aarch64::Label native_method;
+    __ Lsr(upper, kArtMethodRegister, 32u);
+    __ Cbnz(upper, &native_method);
+    __ Orr(kArtMethodRegister, kArtMethodRegister, kArtCompressedReferenceBase);
+    __ Bind(&native_method);
+  }
+#endif
   uint32_t core_spills_offset = frame_size - GetCoreSpillSize();
