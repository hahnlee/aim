@@ -173,6 +173,13 @@ class JNIMacroAssembler {
     UNUSED(reg);
   }
 
+  // Normalize the managed ArtMethod argument to ART's native pointer ABI
+  // before publishing a quick frame. Android low-address pointers need no
+  // work; Darwin maps logical image addresses into its managed host window.
+  virtual void NormalizeMethodPointer(ManagedRegister reg) {
+    UNUSED(reg);
+  }
+
   // Exploit fast access in managed code to Thread::Current()
   virtual void GetCurrentThread(ManagedRegister dest) = 0;
   virtual void GetCurrentThread(FrameOffset dest_offset) = 0;
