diff --git a/AnimatorManager.cpp b/AnimatorManager.cpp
index 0000000..0000000 100644
--- a/AnimatorManager.cpp
+++ b/AnimatorManager.cpp
@@ -155,6 +155,20 @@ void AnimatorManager::animateNoDamage(TreeInfo& info) {
     animateCommon(info);
 }
 
+void AnimatorManager::animateWithContext(AnimationContext& context) {
+    if (!mAnimationHandle) return;
+    pushStaging();
+    auto newEnd = std::remove_if(mAnimators.begin(), mAnimators.end(),
+                                 [&context](sp<BaseRenderNodeAnimator>& animator) {
+                                     const bool remove = animator->animate(context);
+                                     if (remove) animator->detach();
+                                     return remove;
+                                 });
+    mAnimators.erase(newEnd, mAnimators.end());
+    mAnimationHandle->notifyAnimationsRan();
+    mParent.mProperties.updateMatrix();
+}
+
 uint32_t AnimatorManager::animateCommon(TreeInfo& info) {
     uint32_t dirtyMask = 0;
     AnimateFunctor functor(info, mAnimationHandle->context(), &dirtyMask);
