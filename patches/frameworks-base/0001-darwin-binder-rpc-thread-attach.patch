+#if defined(__APPLE__)
+class DarwinBinderThreadAttachment {
+public:
+    JNIEnv* env(JavaVM* requestedVm) {
+        JNIEnv* result = nullptr;
+        const jint status = requestedVm->GetEnv(reinterpret_cast<void**>(&result), JNI_VERSION_1_4);
+        if (status == JNI_OK) return result;
+        if (status != JNI_EDETACHED || mVM != nullptr ||
+            requestedVm->AttachCurrentThread(&result, nullptr) != JNI_OK) {
+            return nullptr;
+        }
+        mVM = requestedVm;
+        return result;
+    }
+
+    ~DarwinBinderThreadAttachment() {
+        if (mVM != nullptr) mVM->DetachCurrentThread();
+    }
+
+private:
+    JavaVM* mVM = nullptr;
+};
+#endif
+
 static JNIEnv* javavm_to_jnienv(JavaVM* vm)
 {
+#if defined(__APPLE__)
+    // Android's kernel Binder pool enters through the Android runtime thread
+    // hook. Binder RPC uses host std::threads, so attach at this platform
+    // boundary and detach when the worker exits.
+    thread_local DarwinBinderThreadAttachment attachment;
+    return vm == nullptr ? nullptr : attachment.env(vm);
+#else
     JNIEnv* env;
     return vm->GetEnv((void **)&env, JNI_VERSION_1_4) >= 0 ? env : NULL;
+#endif
 }

