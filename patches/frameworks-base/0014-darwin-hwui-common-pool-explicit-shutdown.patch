+
+// Set by instance() once the singleton has actually been constructed.
+static std::mutex g_darwin_common_pool_lock;
+static CommonPool* g_darwin_common_pool = nullptr;
+static std::once_flag g_darwin_common_pool_shutdown_once;
+
+void CommonPool::shutdown() {
+    // Do not call instance() here: zygote shutdown must not lazily create
+    // HWUI workers (their JNI attachment is correctly forbidden by ART).
+    std::call_once(g_darwin_common_pool_shutdown_once, [] {
+        CommonPool* pool = nullptr;
+        {
+            std::lock_guard lock(g_darwin_common_pool_lock);
+            pool = g_darwin_common_pool;
+        }
+        if (pool != nullptr) pool->stop();
+    });
+}
+
+extern "C" __attribute__((visibility("default"))) void aim_hwui_shutdown_common_pool() {
+    CommonPool::shutdown();
+}
