diff --git a/apex/LayoutlibLoader.cpp b/apex/LayoutlibLoader.cpp
--- a/apex/LayoutlibLoader.cpp
+++ b/apex/LayoutlibLoader.cpp
@@ -20,5 +20,6 @@
 #include <vector>
 
 #include "Properties.h"
+#include "darwin_hwui_gpu_mode.h"
 #include "android/graphics/jni_runtime.h"
 #include "graphics_jni_helpers.h"
@@ -198,6 +199,11 @@
 using namespace android::uirenderer;
 
 void init_android_graphics() {
-    Properties::overrideRenderPipelineType(RenderPipelineType::SkiaCpu);
+    // Layoutlib historically forces a CPU canvas.  Darwin's GPU HWUI path
