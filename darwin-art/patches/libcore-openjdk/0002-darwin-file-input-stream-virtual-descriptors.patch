--- a/ojluni/src/main/native/FileInputStream.c
+++ b/ojluni/src/main/native/FileInputStream.c
@@ -41,6 +41,14 @@

 #include "jvm.h"

+#if defined(DARWIN_ART_OPENJDK_VIRTUAL_DESCRIPTORS)
+// sys/ioctl.h may replace a command-line/forced-include alias. Rebind after
