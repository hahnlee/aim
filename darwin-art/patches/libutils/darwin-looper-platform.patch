+int Looper::controlPoll(int operation, int fd, const epoll_event* event,
+                        const DarwinArtLooperRegistration* removed) {
+    DarwinArtLooperRegistration previous{};
+    if (removed) previous = *removed;
+    else if (operation == EPOLL_CTL_MOD) {
+        auto sequence = mSequenceNumberByFd.find(fd);
+        if (sequence == mSequenceNumberByFd.end()) { errno = ENOENT; return -1; }
+        auto request = mRequests.find(sequence->second);
+        if (request == mRequests.end()) { errno = ENOENT; return -1; }
+        const auto mask = request->second.getEpollEvents();
+        previous = {sequence->second,
+            ((mask & EPOLLIN) ? 1u : 0u) | ((mask & EPOLLOUT) ? 2u : 0u), 0}; if (!previous.mask) previous.mask = 4;
+    }
+    DarwinArtLooperRegistration next{};
+    if (event) {
+        next = {event->data.u64,
+            ((event->events & EPOLLIN) ? 1u : 0u) | ((event->events & EPOLLOUT) ? 2u : 0u), 0};
+        // Android monitors terminal conditions even without INPUT/OUTPUT.
+        // Explicit native error-only mode is distinct from removing a watch.
+        if (next.mask == 0) next.mask = 4;
+    }
+    const auto result = mEpollFd.transition(fd, previous, next);
+    if (result.rollback_error) scheduleEpollRebuildLocked();
+    if (result.operation_error) { errno = result.operation_error; return -1; }
+    return 0;
+}
