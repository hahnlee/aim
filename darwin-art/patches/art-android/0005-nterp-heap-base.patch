diff --git a/runtime/interpreter/mterp/arm64ng/main.S b/runtime/interpreter/mterp/arm64ng/main.S
--- a/runtime/interpreter/mterp/arm64ng/main.S
+++ b/runtime/interpreter/mterp/arm64ng/main.S
@@ -183,6 +183,34 @@
  */
 .macro GET_VREG reg, vreg
     ldr     \reg, [xFP, \vreg, uxtw #2]
+.endm
+/*
+ * Nterp keeps references in W registers as their 32-bit value (the vreg and
+ * heap encoding). With ART_HEAP_REFERENCE_BASE the X register of a non-null
+ * reference must get the base before it is dereferenced or passed to a C++
+ * entrypoint as mirror::Object*. The W register keeps the 32-bit value.
+ */
+.macro DECODE_NON_NULL_HEAP_REF xreg
+#if ART_HEAP_REFERENCE_BASE != 0
+    orr     \xreg, \xreg, #ART_HEAP_REFERENCE_BASE
+#endif
+.endm
+.macro DECODE_NULLABLE_HEAP_REF xreg, wreg
+    cbz     \wreg, 987f
+    DECODE_NON_NULL_HEAP_REF \xreg
+987:
+.endm
+/* A boot image ArtMethod* can arrive as its 32-bit logical image address. */
+.macro NORMALIZE_ART_METHOD
+#if ART_HEAP_REFERENCE_BASE != 0
+    cbz     x0, 988f
+    mov     ip2, x0
+    lsr     ip2, ip2, #32
+    cbnz    ip2, 988f
+    mov     ip2, #ART_HEAP_REFERENCE_BASE
+    orr     x0, x0, ip2
+988:
+#endif
 .endm
 .macro GET_VREG_OBJECT reg, vreg
     ldr     \reg, [xREFS, \vreg, uxtw #2]
@@ -1381,7 +1409,9 @@
    .if \is_object
    cbz     \value, \label
    ldr     ip, [xSELF, #THREAD_CARD_TABLE_OFFSET]
-   lsr     wip2, \holder, #CARD_TABLE_CARD_SHIFT
+   mov     wip2, \holder
+   DECODE_NON_NULL_HEAP_REF ip2
+   lsr     ip2, ip2, #CARD_TABLE_CARD_SHIFT
    strb    wip, [ip, ip2]
 \label:
    .endif
@@ -1569,6 +1599,7 @@
 
 OAT_ENTRY ExecuteNterpWithClinitImpl
     .cfi_startproc
+    NORMALIZE_ART_METHOD
     // For simplicity, we don't do a read barrier here, but instead rely
     // on art_quick_resolution_trampoline to always have a suspend point before
     // calling back here.
@@ -1598,6 +1629,7 @@
 
 OAT_ENTRY ExecuteNterpImpl
     .cfi_startproc
+    NORMALIZE_ART_METHOD
     sub x16, sp, #STACK_OVERFLOW_RESERVED_BYTES
     ldr wzr, [x16]
     /* Spill callee save regs */
