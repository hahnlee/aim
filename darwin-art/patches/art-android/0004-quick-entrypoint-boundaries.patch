 static constexpr bool kUseTlabFastPath = true;
+
+// Quick allocation entrypoints have an AOSP raw-pointer ABI: their Class*
+// argument is a native pointer even when the caller carries a compressed
+// heap reference.  Keep the boundary defensive because oat
+// code and generic quick stubs can enter this ABI without the optimizing
+// compiler's explicit decode sequence.  Already-decoded pointers are left
+// untouched; zero remains null.  This is a host ABI normalization, not a
+// test-specific or interpreter fallback.
+static ALWAYS_INLINE mirror::Class* DecodeAllocationClassArgument(mirror::Class* klass) {
+#if ART_HEAP_REFERENCE_BASE != 0
+  const uintptr_t address = reinterpret_cast<uintptr_t>(klass);
+  if (address != 0u && address < kArtCompressedReferenceBase) {
+    return reinterpret_cast<mirror::Class*>(kArtCompressedReferenceBase +
+                                           static_cast<uint32_t>(address));
+  }
+#endif
+  return klass;
+}
 
