+#ifndef ART_COMPILER_UTILS_ARM64_HEAP_REFERENCE_ARM64_H_
+#define ART_COMPILER_UTILS_ARM64_HEAP_REFERENCE_ARM64_H_
+
+#include "aarch64/macro-assembler-aarch64.h"
+#include "base/globals.h"
+
+namespace art HIDDEN {
+namespace arm64 {
+
+// Managed code keeps a heap reference as its 32-bit value (see
+// ART_HEAP_REFERENCE_BASE in base/globals.h): HIR values, stack maps, spills,
+// poisoning and read barriers are unchanged. Only a memory access through a
+// reference, or a call that passes a mirror::Object* to the runtime, needs the
+// native address `base | reference`. These helpers emit that conversion; they
+// never allocate a scratch register, so the caller owns the destination for
+// the whole memory operation.
+template <uintptr_t Base = kArtCompressedReferenceBase>
+struct ReferenceCodegenARM64 {
+  static_assert((Base & UINT32_MAX) == 0, "reference window must be 4GiB aligned");
+  // ORR takes a single-bit logical immediate directly; an arbitrary constant
+  // could make VIXL allocate a hidden scratch register to materialize it.
+  static_assert(Base == 0 || (Base & (Base - 1)) == 0,
+                "reference base must be zero or a single-bit logical immediate");
+  static constexpr bool kNeedsHeapBase = Base != 0;
+
+  // Native null or a pointer inside the window -> 32-bit reference. The low
+  // 32 bits are the reference because the base is 4 GiB aligned.
+  // Does not alter flags.
+  static void Encode(vixl::aarch64::MacroAssembler* assembler,
+                     vixl::aarch64::Register destination,
+                     vixl::aarch64::Register address) {
+    assembler->Uxtw(destination.X(), address.W());
+  }
+
+  // Only for a reference already known to be non-null. May alias its input;
+  // the caller must preserve a still-live HIR value. Does not alter flags.
+  static void DecodeNonNull(vixl::aarch64::MacroAssembler* assembler,
+                            vixl::aarch64::Register destination,
+                            vixl::aarch64::Register reference) {
+    assembler->Uxtw(destination.X(), reference.W());
+    if constexpr (Base != 0) {
+      assembler->Orr(destination.X(), destination.X(), Base);
+    }
+  }
+
+  // Reference -> native pointer, keeping null as native null. Clobbers the
+  // condition flags when the base is nonzero.
+  static void DecodeNullable(vixl::aarch64::MacroAssembler* assembler,
+                             vixl::aarch64::Register destination,
+                             vixl::aarch64::Register reference) {
+    assembler->Uxtw(destination.X(), reference.W());
+    if constexpr (Base != 0) {
+      assembler->Cmp(destination.W(), 0);
+      assembler->Orr(destination.X(), destination.X(), Base);
+      assembler->Csel(destination.X(), vixl::aarch64::xzr, destination.X(), vixl::aarch64::eq);
+    }
+  }
+};
+
+}  // namespace arm64
+}  // namespace art
