+// Darwin parking for ART's pthread fallback. Waiters park on a 32-bit word
+// with os_sync_wait_on_address (the primitive under libc++'s atomic wait).
+// Per-mutex state would change the Mutex layout that other translation units
+// compile against, so waiter counts and wake generations live in a striped
+// side table keyed by the mutex address; a collision costs a spurious wake.
+struct alignas(64) DarwinParkingStripe {
+  std::atomic<uint32_t> waiters{0};
+  std::atomic<uint32_t> generation{0};
+};
+constexpr size_t kDarwinParkingStripes = 256;
+DarwinParkingStripe gDarwinParkingStripes[kDarwinParkingStripes];
+
+DarwinParkingStripe& ParkingStripeFor(const void* mutex) {
+  const uintptr_t address = reinterpret_cast<uintptr_t>(mutex);
+  return gDarwinParkingStripes[((address >> 6) ^ (address >> 14)) % kDarwinParkingStripes];
+}
+
+void* ParkingWord(Atomic<pid_t>& word) {
+  return const_cast<pid_t*>(word.Address());
+}
+
+// Parks while the 32-bit word at `word` still holds `expected`. Returns on a
+// wake, a timeout, a changed value or an interrupted wait; callers re-check.
+void DarwinParkOn(void* word, uint32_t expected, uint64_t timeout_ns) {
+  if (timeout_ns == 0) {
+    os_sync_wait_on_address(word, expected, sizeof(uint32_t), OS_SYNC_WAIT_ON_ADDRESS_NONE);
+  } else {
+    os_sync_wait_on_address_with_timeout(word, expected, sizeof(uint32_t),
+                                         OS_SYNC_WAIT_ON_ADDRESS_NONE,
+                                         OS_CLOCK_MACH_ABSOLUTE_TIME, timeout_ns);
+  }
+}
+
+// Monitor locks use the owner tid word itself as the lock. A contended
+// acquirer registers in its stripe, then parks on the owner value it saw; the
+// owner's release wakes one parked thread. Both sides use sequentially
+// consistent operations, so a release either sees the registered waiter or
+// the waiter sees the released word.
+void DarwinMonitorLock(Atomic<pid_t>& owner_word, const void* mutex, pid_t self_tid) {
+  // Monitors are usually held briefly: spin (then yield) for a short while
+  // before paying for a kernel park and wake, as the futex path's BackOff
+  // does on Linux.
+  constexpr uint32_t kSpins = 64;
+  constexpr uint32_t kYields = 16;
+  for (uint32_t i = 0; i < kSpins + kYields; ++i) {
+    if (owner_word.load(std::memory_order_relaxed) == 0 &&
+        owner_word.CompareAndSetStrongSequentiallyConsistent(0, self_tid)) {
+      return;
+    }
+    if (i < kSpins) {
+      __builtin_arm_yield();
+    } else {
+      sched_yield();
+    }
+  }
+  DarwinParkingStripe& stripe = ParkingStripeFor(mutex);
+  stripe.waiters.fetch_add(1, std::memory_order_seq_cst);
+  for (;;) {
+    const pid_t owner = owner_word.load(std::memory_order_seq_cst);
+    if (owner == 0) {
+      if (owner_word.CompareAndSetStrongSequentiallyConsistent(0, self_tid)) {
+        break;
+      }
+      continue;
+    }
+    DarwinParkOn(ParkingWord(owner_word), static_cast<uint32_t>(owner), 0);
+  }
+  stripe.waiters.fetch_sub(1, std::memory_order_relaxed);
+}
+
+void DarwinMonitorWake(Atomic<pid_t>& owner_word, const void* mutex) {
+  if (ParkingStripeFor(mutex).waiters.load(std::memory_order_seq_cst) != 0) {
+    os_sync_wake_by_address_any(ParkingWord(owner_word), sizeof(uint32_t),
+                                OS_SYNC_WAKE_BY_ADDRESS_NONE);
+  }
+}
+}  // namespace
+
+DarwinCheckpointPark::DarwinCheckpointPark(const BaseMutex* mutex)
+    : waiters_(ParkingStripeFor(mutex).waiters),
+      generation_(ParkingStripeFor(mutex).generation) {
+  waiters_.fetch_add(1, std::memory_order_seq_cst);
+  // Pairs with Wake(): either the waker sees this waiter, or the lock
+  // attempt that follows sees the waker's unlock.
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+}
+
+DarwinCheckpointPark::~DarwinCheckpointPark() {
+  waiters_.fetch_sub(1, std::memory_order_relaxed);
+}
 
+uint32_t DarwinCheckpointPark::Generation() const {
+  return generation_.load(std::memory_order_seq_cst);
+}
+
+void DarwinCheckpointPark::Wait(uint32_t generation, bool bounded) const {
+  DarwinParkOn(&generation_, generation, bounded ? 1'000'000 : 0);
+}
+
+namespace {
+void WakeParkingStripe(DarwinParkingStripe& stripe) {
+  if (stripe.waiters.load(std::memory_order_seq_cst) != 0) {
+    stripe.generation.fetch_add(1, std::memory_order_seq_cst);
+    os_sync_wake_by_address_all(&stripe.generation, sizeof(uint32_t),
+                                OS_SYNC_WAKE_BY_ADDRESS_NONE);
+  }
+}
+}  // namespace
+
+void DarwinCheckpointPark::Wake(const BaseMutex* mutex) {
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  WakeParkingStripe(ParkingStripeFor(mutex));
+}
+
+void DarwinCheckpointPark::WakeAll() {
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  for (DarwinParkingStripe& stripe : gDarwinParkingStripes) {
+    WakeParkingStripe(stripe);
+  }
+}
+#endif
