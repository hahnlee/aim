+#if defined(__APPLE__)
+// Darwin: the status of a guest device path (/system, /apex, /data, ...) the
+// host does not have, from the process's Android filesystem namespace, so
+// ART sees the same files as the rest of the process.
+static bool GuestStat(const char* name, struct stat* st) {
+  return ::darwin_art_archive_stat != nullptr && ::darwin_art_archive_stat(name, st);
+}
+#endif
+
+static bool StatPath(const char* name, struct stat* st) {
+  if (stat(name, st) == 0) return true;
+#if defined(__APPLE__)
+  if (errno == ENOENT && name[0] == '/') return GuestStat(name, st);
+#endif
+  return false;
+}
