+void DumpDarwinOriginalFaultContext(siginfo_t* siginfo, void* context) {
+  // This runs only after ART's generated-code handlers declined the signal.
+  // Bounded raw context first; no allocation, locks or symbol lookup. Mach
+  // instruction/map queries below are best-effort, not a signal-safety promise.
+  char line[2048];
+  darwin_art::diagnostics::FaultLogBuffer output(line, sizeof(line));
+  output.AppendLiteral("ART unhandled native fault");
+  auto append_hex = [&](const char* label, uintptr_t value) {
+    output.AppendLiteral(label);
+    // Existing labels include 0x; AppendHex supplies that prefix itself.
+    char digits[sizeof(value) * 2u + 1u];
+    for (size_t index = 0; index < sizeof(value) * 2u; ++index) {
+      const unsigned shift = (sizeof(value) * 2u - index - 1u) * 4u;
+      digits[index] = "0123456789abcdef"[(value >> shift) & 0xfu];
+    }
+    digits[sizeof(value) * 2u] = '\0';
+    output.AppendLiteral(digits);
+  };
+  arm_thread_state64_t& state =
+      reinterpret_cast<ucontext_t*>(context)->uc_mcontext->__ss;
+  append_hex(" pc=0x", arm_thread_state64_get_pc(state));
+#if __DARWIN_OPAQUE_ARM_THREAD_STATE64
+  append_hex(" raw_pc=0x", reinterpret_cast<uintptr_t>(state.__opaque_pc));
+  append_hex(" raw_lr=0x", reinterpret_cast<uintptr_t>(state.__opaque_lr));
+  append_hex(" flags=0x", state.__opaque_flags);
+#else
+  append_hex(" raw_pc=0x", state.__pc);
+  append_hex(" raw_lr=0x", state.__lr);
+#endif
+  append_hex(" pid=0x", static_cast<uintptr_t>(getpid()));
+  append_hex(" sp=0x", arm_thread_state64_get_sp(state));
+  append_hex(" fp=0x", arm_thread_state64_get_fp(state));
+  append_hex(" lr=0x", arm_thread_state64_get_lr(state));
+  append_hex(" addr=0x", reinterpret_cast<uintptr_t>(siginfo->si_addr));
+  append_hex(" code=0x", static_cast<uintptr_t>(siginfo->si_code));
+  for (size_t index = 0u; index <= 28u; ++index) {
+    char label[] = " x00=0x";
+    label[2] = '0' + index / 10u;
+    label[3] = '0' + index % 10u;
+    append_hex(label, state.__x[index]);
+  }
+  // Emit mandatory context before any best-effort Mach IPC diagnostic.
+  const auto mandatory = output.Finish();
+  const ssize_t ignored_context = write(STDERR_FILENO, mandatory.data, mandatory.size);
+  (void)ignored_context;
+  darwin_art::diagnostics::FaultLogBuffer provenance(line, sizeof(line));
+  provenance.AppendLiteral("ART native fault provenance");
+  auto append_provenance = [&](const char* label, uintptr_t value) {
+    provenance.AppendLiteral(label);
+    provenance.AppendHex(value);
+  };
+  append_provenance(" pid=", static_cast<uintptr_t>(getpid()));
+  append_provenance(" pc=", arm_thread_state64_get_pc(state));
+  append_provenance(" lr=", arm_thread_state64_get_lr(state));
+  {
+    mach_vm_address_t region =
+        static_cast<mach_vm_address_t>(arm_thread_state64_get_pc(state));
+    mach_vm_size_t region_size = 0;
+    vm_region_basic_info_data_64_t info = {};
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    const kern_return_t kr = mach_vm_region(
+        mach_task_self(), &region, &region_size, VM_REGION_BASIC_INFO_64,
+        reinterpret_cast<vm_region_info_t>(&info), &count, &object);
+    append_provenance(" map_kr=", static_cast<uintptr_t>(kr));
+    append_provenance(" map_base=", static_cast<uintptr_t>(region));
+    append_provenance(" map_size=", static_cast<uintptr_t>(region_size));
+    const auto pc = static_cast<mach_vm_address_t>(arm_thread_state64_get_pc(state));
+    append_provenance(" map_contains_pc=", kr == KERN_SUCCESS &&
+        pc >= region && pc - region < region_size);
+    append_provenance(" map_prot=", static_cast<uintptr_t>(
+        kr == KERN_SUCCESS ? info.protection : 0));
+    append_provenance(" map_max=", static_cast<uintptr_t>(
+        kr == KERN_SUCCESS ? info.max_protection : 0));
+    if (object != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), object);
+  }
+  {
+    uint32_t pc_words[4] = {};
+    mach_vm_size_t pc_copied = 0;
+    const kern_return_t pc_kr = mach_vm_read_overwrite(
+        mach_task_self(), arm_thread_state64_get_pc(state), sizeof(pc_words),
+        reinterpret_cast<mach_vm_address_t>(pc_words), &pc_copied);
+    append_provenance(" pc_read_kr=", static_cast<uintptr_t>(pc_kr));
+    append_provenance(" pc_read_bytes=", pc_copied);
+    if (pc_kr == KERN_SUCCESS && pc_copied == sizeof(pc_words)) {
+      append_provenance(" pc_word0=", pc_words[0]);
+      append_provenance(" pc_word1=", pc_words[1]);
+      append_provenance(" pc_word2=", pc_words[2]);
+      append_provenance(" pc_word3=", pc_words[3]);
+    }
+    const mach_vm_address_t lr =
+        static_cast<mach_vm_address_t>(arm_thread_state64_get_lr(state));
+    uint32_t words[4] = {};
+    mach_vm_size_t copied = 0;
+    const mach_vm_address_t start = lr >= 16u ? lr - 16u : lr;
+    const kern_return_t read_kr = mach_vm_read_overwrite(
+        mach_task_self(), start, sizeof(words),
+        reinterpret_cast<mach_vm_address_t>(words), &copied);
+    append_provenance(" lr_read_kr=", static_cast<uintptr_t>(read_kr));
+    append_provenance(" lr_read_bytes=", copied);
+    if (read_kr == KERN_SUCCESS && copied == sizeof(words)) {
+      append_provenance(" lr_m16=", words[0]);
+      append_provenance(" lr_m12=", words[1]);
+      append_provenance(" lr_m8=", words[2]);
+      append_provenance(" lr_m4=", words[3]);
+    }
+  }
+  if (provenance.truncated()) {
+    constexpr char marker[] = "ART native fault provenance truncated\n";
+    const ssize_t ignored_marker = write(STDERR_FILENO, marker, sizeof(marker) - 1u);
+    (void)ignored_marker;
+  }
+  const auto result = provenance.Finish();
+  const ssize_t ignored = write(STDERR_FILENO, result.data, result.size);
+  (void)ignored;
+}
