+static int DupRuntimeFdCloexec(int fd) {
+#if defined(__APPLE__)
+  // ART receives the same Android process descriptor that Java/libcore
+  // exposes. Darwin kernel APIs cannot consume that guest descriptor number,
+  // so export a duplicate of its underlying open-file description only at
+  // this native boundary. The trace writer then owns and closes the host fd,
+  // exactly as it owns DupCloexec()'s result on Android.
+  int copy = -1;
+  if (darwin_art_bionic_fd_dup_host_fd_core(fd, &copy) < 1) return -1;
+  if (copy >= 0 && fcntl(copy, F_SETFD, FD_CLOEXEC) != 0) {
+    int saved_errno = errno;
+    close(copy);
+    errno = saved_errno;
+    return -1;
+  }
+  return copy;
+#else
+  return DupCloexec(fd);
+#endif
+}
 
