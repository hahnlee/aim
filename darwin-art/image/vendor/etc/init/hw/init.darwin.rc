# The darwin device: the original Android userspace as Darwin processes
# (docs/adr/0012-original-android-userspace.md). init.rc imports
# /vendor/etc/init/hw/init.${ro.hardware}.rc, and darwin-guest-init boots
# with androidboot.hardware=darwin. Only what this device needs is here;
# the HALs start from their own .rc files.

on early-init
    # The GLES driver the original libEGL loads:
    # /vendor/lib64/egl/libGLES_darwin.so (docs/gles-driver.md).
    setprop ro.hardware.egl darwin
    # ANGLE's Metal backend implements OpenGL ES 3.0 (0x30000).
    setprop ro.opengles.version 196608
    # There is no Vulkan driver yet, so RenderEngine renders with GLES.
    setprop debug.renderengine.backend skiaglthreaded
    # A Retina display at 2x.
    setprop ro.sf.lcd_density 320

# Partitions are directories of the derived image and /data is a host
# directory: darwin-guest-init's mount_all mounts nothing and raises the
# triggers init would.
on fs
    mount_all /vendor/etc/fstab.darwin --early

on late-fs
    mount_all /vendor/etc/fstab.darwin --late
