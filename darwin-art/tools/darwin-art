#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
ctl="$root/target/release/darwin-artctl"
require_build() {
  [[ -x "$ctl" ]] || {
    echo "Darwin ART is not built; run cargo xtask build once" >&2
    exit 69
  }
}
command="${1:-}"
case "$command" in
  install)
    # A PackageInstaller session in the profile's PackageManagerService.
    shift
    [[ $# -ge 1 ]] || {
      echo "usage: darwin-art install APK [--split SPLIT_APK]..." >&2
      exit 64
    }
    "$root/tools/run-android-apk-app.sh" --install "$@"
    ;;
  run)
    package="${2:-}"
    seconds="${3:-86400}"
    [[ -n "$package" ]] || {
      echo "usage: darwin-art run PACKAGE [VISIBLE_SECONDS]" >&2
      exit 64
    }
    require_build
    "$root/tools/run-android-apk-app.sh" --package "$package" "$seconds"
    ;;
  list)
    # Installed apps, from PackageManagerService's packages.list.
    require_build
    "$ctl" ensure >/dev/null
    "$ctl" list
    ;;
  ps)
    require_build
    "$ctl" ensure >/dev/null
    "$ctl" ps
    ;;
  *)
    echo "usage: darwin-art {install APK [--split SPLIT_APK]...|run PACKAGE [VISIBLE_SECONDS]|list|ps}" >&2
    exit 64
    ;;
esac
