<?xml version="1.0" encoding="utf-8"?>
<familyset version="23">
    <family name="sans-serif">
        <font weight="400" style="normal" postScriptName="Roboto-Regular">
            Roboto-Regular.ttf
        </font>
    </family>
    <alias name="serif" to="sans-serif" weight="400" />
    <alias name="monospace" to="sans-serif" weight="400" />
    <!-- Calculator's DisplayEditTextStyle requests this Android stock alias;
         the tiny Darwin font root maps every stock weight to the pinned
         Roboto face rather than leaving Typeface.create(null, style). -->
    <alias name="sans-serif-thin" to="sans-serif" weight="400" />
    <alias name="sans-serif-light" to="sans-serif" weight="400" />
    <alias name="sans-serif-medium" to="sans-serif" weight="400" />
    <alias name="sans-serif-black" to="sans-serif" weight="400" />
</familyset>
